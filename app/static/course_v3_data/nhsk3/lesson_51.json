      "dialogue": [
        {
          "speaker": "王一雪",
          "zh": "你看我穿这条黄色的短裤好看吗？",
          "pinyin": "Nǐ kàn wǒ chuān zhè tiáo huángsè de duǎnkù hǎokàn ma?",
