        },
        {
          "speaker": "王一雪",
          "zh": "裙子480，短裤400。",
          "pinyin": "Qúnzi sìbǎi bāshí, duǎnkù sìbǎi.",
          "text": {
            "uz": "Yubka 480, shortik 400.",
            "ru": "Юбка — 480, шорты — 400.",
            "tj": "Юбка 480, шорт 400."
