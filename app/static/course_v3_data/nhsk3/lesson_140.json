      "examples": [
        {
          "zh": "他从那时起就努力学习。",
          "pinyin": "Tā cóng nà shí qǐ jiù nǔlì xuéxí.",
          "translation": {
            "uz": "U o‘sha paytdan boshlab astoydil o‘qiy boshladi.",
            "ru": "С того времени он стал усердно учиться.",
            "tj": "Ӯ аз ҳамон вақт сар карда ҷиддӣ таҳсил кард."
          }
        },
        {
          "zh": "从那天起，我们就变成了好朋友。",
          "pinyin": "Cóng nà tiān qǐ, wǒmen jiù biànchéng le hǎo péngyou.",
          "translation": {
            "uz": "O‘sha kundan boshlab biz yaxshi do‘st bo‘lib qoldik.",
            "ru": "С того дня мы стали хорошими друзьями.",
            "tj": "Аз ҳамон рӯз мо дӯстони хуб шудем."
          }
        },
        {
          "zh": "从那次旅游起，我对中国文化更有兴趣了。",
          "pinyin": "Cóng nà cì lǚyóu qǐ, wǒ duì Zhōngguó wénhuà gèng yǒu xìngqù le.",
          "translation": {
            "uz": "O‘sha sayohatdan boshlab Xitoy madaniyatiga qiziqishim yanada oshdi.",
            "ru": "После той поездки я стал ещё больше интересоваться китайской культурой.",
            "tj": "Аз ҳамон сафар сар карда шавқам ба фарҳанги Чин боз ҳам зиёд шуд."
          }
        }
      ]
    }
