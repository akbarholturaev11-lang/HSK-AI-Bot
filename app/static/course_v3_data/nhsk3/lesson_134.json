    {
      "scene": {
        "uz": "O‘quv binosida Liu Xiaoxue va sinfdoshi yurib suhbatlashmoqda.",
        "ru": "В учебном корпусе Лю Сяосюэ и одноклассник идут и разговаривают.",
        "tj": "Дар бинои таълимӣ Лю Сяосюэ ва ҳамсинфаш роҳравон суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "刘小雪",
          "zh": "怎么回事？",
          "pinyin": "Zěnme huí shì?",
          "text": {
            "uz": "Nima bo‘ldi?",
            "ru": "Что случилось?",
            "tj": "Чӣ гап шуд?"
          }
        },
        {
          "speaker": "刘小雪",
          "zh": "你想多了，做错事情是很常见的。",
          "pinyin": "Nǐ xiǎng duō le, zuò cuò shìqing shì hěn chángjiàn de.",
          "text": {
            "uz": "Ortiqcha o‘ylayapsan, xato qilish juda odatiy hol.",
            "ru": "Ты слишком переживаешь, ошибаться — обычное дело.",
            "tj": "Аз ҳад зиёд фикр мекунӣ, хато кардан кори маъмул аст."
          }
        },
        {
          "speaker": "同学",
          "zh": "你说的就是我，以后我要多向认真的人学习。",
          "pinyin": "Nǐ shuō de jiù shì wǒ, yǐhòu wǒ yào duō xiàng rènzhēn de rén xuéxí.",
          "text": {
            "uz": "Aytganing aynan men haqimda. Bundan keyin jiddiy odamlaridan ko‘proq o‘rganaman.",
            "ru": "Ты точно описала меня. Теперь я буду больше учиться у серьёзных людей.",
            "tj": "Гуфтаат айнан ман ҳастам. Минбаъд аз одамони ҷиддӣ бештар меомӯзам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "O‘quv zali oldida Bai Jiayue Chen Tianzhongni uchratdi.",
        "ru": "У входа в читальный зал Бай Цзяюэ встретила Чэнь Тяньчжуна.",
        "tj": "Дар назди толори хониш Бай Ҷяюэ бо Чэн Тянҷун вохӯрд."
      },
      "dialogue": [
        {
          "speaker": "陈天中",
          "zh": "这有什么奇怪的？我是来学习的。",
          "pinyin": "Zhè yǒu shénme qíguài de? Wǒ shì lái xuéxí de.",
          "text": {
            "uz": "Buning nimasi g‘alati? Men o‘qigani keldim.",
            "ru": "Что тут странного? Я пришёл заниматься.",
            "tj": "Ин чӣ аҷиб дорад? Ман барои хондан омадам."
          }
        },
        {
          "speaker": "白家月",
          "zh": "你怎么还来图书馆学习？同学们都在到处找工作呢。",
          "pinyin": "Nǐ zěnme hái lái túshūguǎn xuéxí? Tóngxuémen dōu zài dàochù zhǎo gōngzuò ne.",
          "text": {
            "uz": "Nega hali ham kutubxonada o‘qiyapsan? Sinfdoshlar hamma joyda ish qidiryapti-ku.",
            "ru": "Почему ты всё ещё учишься в библиотеке? Однокурсники повсюду ищут работу.",
            "tj": "Чаро ҳоло ҳам дар китобхона мехонӣ? Ҳамсинфон ҳама ҷо кор меҷӯянд."
          }
        },
        {
          "speaker": "白家月",
          "zh": "你不是喜欢玩电脑吗？你可以去看看跟电脑有关的书。",
          "pinyin": "Nǐ bú shì xǐhuan wán diànnǎo ma? Nǐ kěyǐ qù kànkan gēn diànnǎo yǒuguān de shū.",
          "text": {
            "uz": "Sen kompyuterni yoqtirmaysanmi? Kompyuterga oid kitoblarni ko‘rib chiq.",
            "ru": "Разве ты не любишь компьютеры? Посмотри книги, связанные с ними.",
            "tj": "Магар ту компютерро дӯст намедорӣ? Китобҳои вобаста ба компютерро бин."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "你说得对，我记得那个屋子里有些跟电脑有关的书，我去找找。",
          "pinyin": "Nǐ shuō de duì, wǒ jìde nàge wūzi lǐ yǒuxiē gēn diànnǎo yǒuguān de shū, wǒ qù zhǎozhao.",
          "text": {
            "uz": "To‘g‘ri aytding, o‘sha xonada kompyuterga oid kitoblar bor edi, borib qidiraman.",
            "ru": "Ты права, я помню, в той комнате были книги о компьютерах. Пойду поищу.",
            "tj": "Дуруст гуфтӣ, дар хотир дорам он ҳуҷра китобҳои вобаста ба компютер дошт, рафта меҷӯям."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Kampusda Li Wen va Chen Tianzhong suhbatlashmoqda.",
        "ru": "В кампусе Ли Вэнь и Чэнь Тяньчжун разговаривают.",
        "tj": "Дар кампус Ли Вэн ва Чэн Тянҷун суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "陈天中",
          "zh": "我的手机没电了。你找我有事吗？",
          "pinyin": "Wǒ de shǒujī méi diàn le. Nǐ zhǎo wǒ yǒu shì ma?",
          "text": {
            "uz": "Telefonimning quvvati tugadi. Menga ishing bormi?",
            "ru": "Телефон разрядился. Ты меня искал по делу?",
            "tj": "Телефонам барқ надорад. Ба ман кор доштӣ?"
          }
        },
        {
          "speaker": "李文",
          "zh": "前天我看见家月了，她告诉我你打算继续留学？",
          "pinyin": "Qiántiān wǒ kànjiàn Jiāyuè le, tā gàosu wǒ nǐ dǎsuàn jìxù liúxué?",
          "text": {
            "uz": "Peshindin Jiayueni ko‘rdim, u sen chet elda o‘qishni davom ettirmoqchi ekaningni aytdi?",
            "ru": "Позавчера я видел Цзяюэ. Она сказала, что ты собираешься продолжить учёбу за границей?",
            "tj": "Пешдирӯз Ҷяюэро дидам, ӯ гуфт ту мехоҳӣ таҳсилро дар хориҷ идома диҳӣ?"
          }
        },
        {
          "speaker": "陈天中",
          "zh": "是，可是我还没想好学什么，更没想好去哪个国家。",
          "pinyin": "Shì, kěshì wǒ hái méi xiǎng hǎo xué shénme, gèng méi xiǎng hǎo qù nǎge guójiā.",
          "text": {
            "uz": "Ha, lekin nimani o‘qishni hali hal qilganim yo‘q, qaysi mamlakatga borishni esa umuman tanlamadim.",
            "ru": "Да, но я ещё не решил, что изучать, и тем более не решил, в какую страну ехать.",
            "tj": "Ҳа, аммо ҳоло чӣ хонданро қарор накардаам, боз кадом кишвар рафтанро ҳам интихоб накардаам."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "好，那我上网查一查。",
          "pinyin": "Hǎo, nà wǒ shàngwǎng chá yì chá.",
          "text": {
            "uz": "Xo‘p, unda internetdan tekshirib ko‘raman.",
            "ru": "Хорошо, тогда посмотрю информацию в интернете.",
            "tj": "Хуб, пас аз интернет маълумот меҷӯям."
          }
        },
        {
          "speaker": "李文",
          "zh": "我给你介绍几个有用的网站。",
          "pinyin": "Wǒ gěi nǐ jièshào jǐ ge yǒuyòng de wǎngzhàn.",
          "text": {
            "uz": "Senga bir nechta foydali saytni tavsiya qilaman.",
            "ru": "Я покажу тебе несколько полезных сайтов.",
            "tj": "Ба ту чанд сомонаи муфидро нишон медиҳам."
          }
        }
      ]
    }
