  "dialogues": [
    {
      "scene": {
        "uz": "Uyda Wang Yixue va Liu Ming xaridga borishni muhokama qilmoqda.",
        "ru": "Дома Ван Исюэ и Лю Мин обсуждают поход за покупками.",
        "tj": "Дар хона Ван Исюэ ва Лю Мин харид рафтанро муҳокима мекунанд."
      },
      "dialogue": [
        {
          "speaker": "刘明",
          "zh": "是啊，她现在长高了，这辆车已经太矮了。",
          "pinyin": "Shì a, tā xiànzài zhǎng gāo le, zhè liàng chē yǐjīng tài ǎi le.",
          "text": {
            "uz": "Ha, u bo‘yi o‘sdi, bu velosiped endi unga juda past.",
            "ru": "Да, она выросла, этот велосипед уже слишком маленький.",
            "tj": "Ҳа, қадаш баланд шуд, ин дучарха ҳоло барои ӯ хеле паст аст."
          }
        },
        {
          "speaker": "王一雪",
          "zh": "商场里开了一家自行车店，咱们给她买辆新的吧。",
          "pinyin": "Shāngchǎng lǐ kāi le yì jiā zìxíngchē diàn, zánmen gěi tā mǎi liàng xīn de ba.",
          "text": {
            "uz": "Savdo markazida velosiped do‘koni ochilibdi, unga yangisini olaylik.",
            "ru": "В торговом центре открылся магазин велосипедов, давай купим ей новый.",
            "tj": "Дар маркази савдо мағозаи дучарха кушода шудааст, биё барояш нав бихарем."
          }
        },
        {
          "speaker": "刘明",
          "zh": "好，咱们带小雪一起去，让她试一下。",
          "pinyin": "Hǎo, zánmen dài Xiǎoxuě yìqǐ qù, ràng tā shì yíxià.",
          "text": {
            "uz": "Mayli, Xiaoxueni ham olib boraylik, o‘zi sinab ko‘rsin.",
            "ru": "Хорошо, возьмём Сяосюэ с собой, пусть попробует.",
            "tj": "Хуб, Сяосюэро ҳам мебарем, бигзор худаш санҷад."
          }
        },
        {
          "speaker": "王一雪",
          "zh": "那今天就去吧！我也想再看看衣服。咱们怎么去？",
          "pinyin": "Nà jīntiān jiù qù ba! Wǒ yě xiǎng zài kànkan yīfu. Zánmen zěnme qù?",
          "text": {
            "uz": "Unda bugun boraylik! Men ham kiyimlarni yana ko‘rmoqchiman. Qanday boramiz?",
            "ru": "Тогда пойдём сегодня! Я ещё хочу посмотреть одежду. Как поедем?",
            "tj": "Пас имрӯз равем! Ман ҳам мехоҳам либосҳоро боз бинам. Чӣ тавр меравем?"
          }
        },
        {
          "speaker": "刘明",
          "zh": "商场不远，咱们可以走着去。",
          "pinyin": "Shāngchǎng bù yuǎn, zánmen kěyǐ zǒuzhe qù.",
          "text": {
            "uz": "Savdo markazi uzoq emas, piyoda borsak bo‘ladi.",
            "ru": "Торговый центр недалеко, можем пойти пешком.",
            "tj": "Маркази савдо дур нест, пиёда рафтан мумкин."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Savdo markazida Liu Ming va Wang Yixue velosipedni olib bo‘lib, kiyim tanlamoqda.",
        "ru": "В торговом центре Лю Мин и Ван Исюэ после покупки велосипеда выбирают одежду.",
