  "dialogues": [
    {
      "scene": {
        "uz": "Ofisda Wang Yixue va Yang Tongle suhbatlashmoqda.",
        "ru": "В офисе Ван Исюэ и Ян Тунлэ разговаривают.",
        "tj": "Дар идора Ван Исюэ ва Ян Тунлэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "杨同乐",
          "zh": "您搬到蓝天小区一段时间了，觉得怎么样？",
          "pinyin": "Nín bān dào Lántiān Xiǎoqū yí duàn shíjiān le, juéde zěnmeyàng?",
          "text": {
            "uz": "Lantian turar-joy majmuasiga ko‘chganingizga bir muddat bo‘ldi, qanday?",
            "ru": "Вы уже некоторое время живёте в жилом комплексе Ланьтянь. Как вам?",
            "tj": "Муддате шуд ба маҷмааи Лантян кӯчидаед, чӣ хел аст?"
          }
        },
        {
          "speaker": "王一雪",
          "zh": "小区环境挺好的，附近买东西也很方便，过马路就是超市。",
          "pinyin": "Xiǎoqū huánjìng tǐng hǎo de, fùjìn mǎi dōngxi yě hěn fāngbiàn, guò mǎlù jiù shì chāoshì.",
          "text": {
            "uz": "Majmuaning muhiti yaxshi, yaqin atrofda xarid qilish ham qulay, yo‘lning narigi tomonida supermarket bor.",
            "ru": "Обстановка хорошая, покупки рядом делать удобно, через дорогу супермаркет.",
            "tj": "Муҳити маҷмаа хуб аст, харид дар наздикӣ ҳам қулай, аз роҳ гузарӣ супермаркет аст."
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "平时孩子们在哪儿玩？",
          "pinyin": "Píngshí háizimen zài nǎr wán?",
          "text": {
            "uz": "Odatda bolalar qayerda o‘ynaydi?",
            "ru": "Где дети обычно играют?",
            "tj": "Одатан кӯдакон дар куҷо бозӣ мекунанд?"
          }
        },
        {
          "speaker": "王一雪",
          "zh": "小区里有很多树，孩子们放学后就在树下做游戏。你想买房子吗？",
          "pinyin": "Xiǎoqū lǐ yǒu hěn duō shù, háizimen fàngxué hòu jiù zài shù xià zuò yóuxì. Nǐ xiǎng mǎi fángzi ma?",
          "text": {
            "uz": "Majmuada daraxtlar ko‘p, bolalar darsdan keyin daraxt tagida o‘ynaydi. Uy sotib olmoqchimisan?",
            "ru": "В комплексе много деревьев, после школы дети играют под ними. Ты хочешь купить жильё?",
            "tj": "Дар маҷмаа дарахт зиёд аст, кӯдакон баъди дарс зери дарахт бозӣ мекунанд. Хона харидан мехоҳӣ?"
          }
        },
        {
          "speaker": "王一雪",
          "zh": "蓝天小区的老人挺多的，这几年小区根据他们的需要，有了很多变化。",
          "pinyin": "Lántiān Xiǎoqū de lǎorén tǐng duō de, zhè jǐ nián xiǎoqū gēnjù tāmen de xūyào, yǒu le hěn duō biànhuà.",
          "text": {
            "uz": "Lantian majmuasida keksalar ancha ko‘p, so‘nggi yillarda ularning ehtiyojlariga ko‘ra ko‘p o‘zgarishlar qilindi.",
            "ru": "В Ланьтяне довольно много пожилых, и в последние годы комплекс сильно изменился с учётом их потребностей.",
            "tj": "Дар маҷмааи Лантян пиронсолон зиёданд ва чанд соли охир мувофиқи ниёзҳои онҳо тағйироти зиёд шудааст."
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "真不错！过几天我去蓝天小区看看。",
          "pinyin": "Zhēn búcuò! Guò jǐ tiān wǒ qù Lántiān Xiǎoqū kànkan.",
          "text": {
            "uz": "Juda yaxshi! Bir necha kundan keyin Lantian majmuasini ko‘rgani boraman.",
            "ru": "Отлично! Через несколько дней съезжу посмотреть Ланьтянь.",
            "tj": "Хеле хуб! Баъди чанд рӯз ба маҷмааи Лантян рафта мебинам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Ofisda Wang Yixue va Yang Tongle suhbatlashmoqda.",
        "ru": "В офисе Ван Исюэ и Ян Тунлэ разговаривают.",
        "tj": "Дар идора Ван Исюэ ва Ян Тунлэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "王一雪",
          "zh": "除了这些以外，你再告诉我一些外地人不知道的地方。",
          "pinyin": "Chúle zhèxiē yǐwài, nǐ zài gàosu wǒ yìxiē wàidì rén bù zhīdào de dìfang.",
          "text": {
            "uz": "Bulardan tashqari, menga tashqaridan kelganlar bilmaydigan joylarni ham ayt.",
            "ru": "Кроме этого, расскажи ещё о местах, которые приезжие обычно не знают.",
            "tj": "Ба ғайр аз инҳо, боз ҷойҳоеро бигӯ, ки одамони аз дигар ҷой омада намедонанд."
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "那太多了，我得一点儿一点儿给您讲。",
          "pinyin": "Nà tài duō le, wǒ děi yìdiǎnr yìdiǎnr gěi nín jiǎng.",
          "text": {
            "uz": "Bunday joylar juda ko‘p, sizga asta-sekin aytib berishim kerak.",
            "ru": "Таких мест очень много, придётся рассказывать понемногу.",
            "tj": "Ин гуна ҷойҳо хеле зиёданд, бояд кам-кам ба шумо нақл кунам."
          }
        },
        {
          "speaker": "王一雪",
          "zh": "行，下班后我请你吃晚饭，咱们边吃边聊。",
          "pinyin": "Xíng, xiàbān hòu wǒ qǐng nǐ chī wǎnfàn, zánmen biān chī biān liáo.",
          "text": {
            "uz": "Mayli, ishdan keyin seni kechki ovqatga taklif qilaman, ovqatlanib turib gaplashamiz.",
            "ru": "Хорошо, после работы угощу тебя ужином, будем есть и разговаривать.",
            "tj": "Хуб, баъди кор туро ба хӯроки шом даъват мекунам, хӯрда истода суҳбат мекунем."
          }
        }
      ]
    }
  ],
