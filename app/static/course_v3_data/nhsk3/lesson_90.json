  "dialogues": [
    {
      "scene": {
        "uz": "Ko‘chada Wang Yifei va Bai Jiayue yurib suhbatlashmoqda.",
        "ru": "На улице Ван Ифэй и Бай Цзяюэ идут и разговаривают.",
        "tj": "Дар кӯча Ван Ифэй ва Бай Ҷяюэ роҳравон суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "王一飞",
          "zh": "上周我去公园坐船了，公园里的花也开了。",
          "pinyin": "Shàng zhōu wǒ qù gōngyuán zuò chuán le, gōngyuán lǐ de huā yě kāi le.",
          "text": {
            "uz": "O‘tgan hafta parkda qayiqda yurdim, u yerdagi gullar ham ochilibdi.",
            "ru": "На прошлой неделе я каталась на лодке в парке, там цветы тоже уже распустились.",
            "tj": "Ҳафтаи гузашта дар боғ қаиқсаворӣ кардам, гулҳои боғ ҳам кушода шудаанд."
          }
        },
        {
          "speaker": "白家月",
          "zh": "天气这么好，下午我也想去公园坐船。",
          "pinyin": "Tiānqì zhème hǎo, xiàwǔ wǒ yě xiǎng qù gōngyuán zuò chuán.",
          "text": {
            "uz": "Havo bunchalik yaxshi ekan, tushdan keyin men ham parkda qayiqda yurmoqchiman.",
            "ru": "Погода такая хорошая, днём я тоже хочу покататься на лодке в парке.",
            "tj": "Ҳаво ин қадар хуб аст, баъд аз нисфирӯзӣ ман ҳам мехоҳам дар боғ қаиқсаворӣ кунам."
          }
        },
        {
          "speaker": "王一飞",
          "zh": "去吧！今天是工作日，人应该不多。",
          "pinyin": "Qù ba! Jīntiān shì gōngzuòrì, rén yīnggāi bù duō.",
          "text": {
            "uz": "Bor! Bugun ish kuni, odam ko‘p bo‘lmasligi kerak.",
            "ru": "Иди! Сегодня рабочий день, людей должно быть немного.",
            "tj": "Рав! Имрӯз рӯзи корӣ аст, одам набояд зиёд бошад."
          }
        },
        {
          "speaker": "白家月",
          "zh": "您有时间吗？我想跟您一起去。",
          "pinyin": "Nín yǒu shíjiān ma? Wǒ xiǎng gēn nín yìqǐ qù.",
          "text": {
            "uz": "Vaqtingiz bormi? Siz bilan birga bormoqchiman.",
            "ru": "У вас есть время? Я хотела бы пойти вместе с вами.",
            "tj": "Вақт доред? Мехоҳам бо шумо якҷо равам."
          }
        },
        {
          "speaker": "王一飞",
          "zh": "我今天下午有课，不能去太远的地方。",
          "pinyin": "Wǒ jīntiān xiàwǔ yǒu kè, bù néng qù tài yuǎn de dìfang.",
          "text": {
            "uz": "Bugun tushdan keyin darsim bor, juda uzoqqa bora olmayman.",
            "ru": "Сегодня днём у меня занятие, далеко ехать не могу.",
            "tj": "Имрӯз баъд аз нисфирӯзӣ дарс дорам, ба ҷои дур рафта наметавонам."
          }
        },
        {
          "speaker": "白家月",
          "zh": "那咱们换一天去？",
          "pinyin": "Nà zánmen huàn yì tiān qù?",
          "text": {
            "uz": "Unda boshqa kuni boramizmi?",
            "ru": "Тогда пойдём в другой день?",
            "tj": "Пас рӯзи дигар равем?"
          }
        },
        {
          "speaker": "王一飞",
          "zh": "行。或者明天去，或者后天去，我给你打电话。",
          "pinyin": "Xíng. Huòzhě míngtiān qù, huòzhě hòutiān qù, wǒ gěi nǐ dǎ diànhuà.",
          "text": {
            "uz": "Mayli. Yoki ertaga, yoki indinga boramiz, men senga telefon qilaman.",
            "ru": "Хорошо. Либо завтра, либо послезавтра — я тебе позвоню.",
            "tj": "Хуб. Ё фардо, ё пасфардо меравем, ман ба ту занг мезанам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Sinfda Wang Yifei va Bai Jiayue yomg‘irdan pana qilmoqda.",
        "ru": "В классе Ван Ифэй и Бай Цзяюэ укрываются от дождя.",
        "tj": "Дар синф Ван Ифэй ва Бай Ҷяюэ аз борон паноҳ мебаранд."
      },
      "dialogue": [
        {
          "speaker": "白家月",
          "zh": "您来这里已经一年多了，习惯了吧？",
          "pinyin": "Nín lái zhèlǐ yǐjīng yì nián duō le, xíguàn le ba?",
          "text": {
            "uz": "Bu yerga kelganingizga bir yildan oshdi, ko‘nikib qolgandirsiz?",
            "ru": "Вы здесь уже больше года, наверное, привыкли?",
            "tj": "Зиёда аз як сол шуд ин ҷо ҳастед, одат кардаед?"
          }
        },
        {
          "speaker": "王一飞",
          "zh": "别的早就习惯了，就是天气我还不太习惯。",
          "pinyin": "Biéde zǎo jiù xíguàn le, jiùshì tiānqì wǒ hái bú tài xíguàn.",
          "text": {
            "uz": "Boshqa narsalarga anchadan beri ko‘nikdim, faqat ob-havoga hali uncha emas.",
            "ru": "Ко всему остальному давно привыкла, только к погоде ещё не совсем.",
            "tj": "Ба дигар чизҳо кайҳо одат кардам, танҳо ба обу ҳаво ҳоло пурра одат накардаам."
          }
        },
        {
          "speaker": "白家月",
          "zh": "为什么？您不喜欢这里的天气吗？",
          "pinyin": "Wèishénme? Nín bù xǐhuan zhèlǐ de tiānqì ma?",
          "text": {
            "uz": "Nega? Bu yerdagi ob-havo sizga yoqmaydimi?",
            "ru": "Почему? Вам не нравится местная погода?",
            "tj": "Чаро? Обу ҳавои ин ҷо ба шумо писанд нест?"
          }
        }
      ]
    }
  ],
