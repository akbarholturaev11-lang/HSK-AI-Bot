  "dialogues": [
    {
      "scene": {
        "uz": "Ko‘chada Bai Jiayue va Li Wen sayr qilib, suhbatlashmoqda.",
        "ru": "На улице Бай Цзяюэ и Ли Вэнь гуляют и разговаривают.",
        "tj": "Дар кӯча Бай Ҷяюэ ва Ли Вэн сайр карда суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "白家月",
          "zh": "这个星期总是阴天，今天终于晴了。",
          "pinyin": "Zhège xīngqī zǒngshì yīntiān, jīntiān zhōngyú qíng le.",
          "text": {
            "uz": "Bu hafta doim bulutli edi, bugun nihoyat havo ochildi.",
            "ru": "Всю неделю было пасмурно, а сегодня наконец ясно.",
            "tj": "Ин ҳафта ҳамеша ҳаво абрнок буд, имрӯз ниҳоят соф шуд."
          }
        },
        {
          "speaker": "李文",
          "zh": "现在天气好得很！我们去爬山怎么样？",
          "pinyin": "Xiànzài tiānqì hǎo de hěn! Wǒmen qù páshān zěnmeyàng?",
          "text": {
            "uz": "Hozir ob-havo juda yaxshi! Tog‘ga chiqishga boramizmi?",
            "ru": "Сейчас погода отличная! Как насчёт похода в горы?",
            "tj": "Ҳоло ҳаво хеле хуб аст! Ба кӯҳ равем чӣ хел?"
          }
        },
        {
          "speaker": "李文",
          "zh": "好主意。给她打个电话吧。",
          "pinyin": "Hǎo zhǔyi. Gěi tā dǎ ge diànhuà ba.",
          "text": {
            "uz": "Yaxshi fikr. Unga telefon qilaylik.",
            "ru": "Хорошая идея. Давай ей позвоним.",
            "tj": "Фикри хуб. Ба ӯ занг занем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Tog‘da Wang Yixue va Bai Jiayue yurib suhbatlashmoqda.",
        "ru": "В горах Ван Исюэ и Бай Цзяюэ идут и разговаривают.",
        "tj": "Дар кӯҳ Ван Исюэ ва Бай Ҷяюэ роҳравон суҳбат мекунанд."
