  "dialogues": [
    {
      "scene": {
        "uz": "Restoranda Wang Yixue, Liu Ming, Bai Jiayue va Li Wen taom buyurtma qilmoqda.",
        "ru": "В ресторане Ван Исюэ, Лю Мин, Бай Цзяюэ и Ли Вэнь выбирают блюда.",
        "tj": "Дар тарабхона Ван Исюэ, Лю Мин, Бай Ҷяюэ ва Ли Вэн хӯрок фармоиш медиҳанд."
      },
      "dialogue": [
        {
          "speaker": "白家月",
          "zh": "飞了这么远，现在还真是又饿又渴。",
          "pinyin": "Fēi le zhème yuǎn, xiànzài hái zhēn shì yòu è yòu kě.",
          "text": {
            "uz": "Shuncha uzoq uchib keldik, hozir rostdan ham ham ochman, ham chanqaganman.",
            "ru": "Так далеко летели — сейчас я и правда и голодна, и хочу пить.",
            "tj": "Ин қадар дур парвоз кардем, ҳоло воқеан ҳам гуруснаам, ҳам ташна."
          }
        },
        {
          "speaker": "王一雪",
          "zh": "没问题。你们看看还想吃什么。",
          "pinyin": "Méi wèntí. Nǐmen kànkan hái xiǎng chī shénme.",
          "text": {
            "uz": "Muammo yo‘q. Yana nima yegingiz kelishini ko‘ringlar.",
            "ru": "Без проблем. Посмотрите, что ещё хотите заказать.",
            "tj": "Мушкил нест. Бинед, боз чӣ хӯрдан мехоҳед."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Restoranda Wang Yixue, Liu Ming, Bai Jiayue va Li Wen birga ovqatlanmoqda.",
        "ru": "В ресторане Ван Исюэ, Лю Мин, Бай Цзяюэ и Ли Вэнь вместе едят.",
        "tj": "Дар тарабхона Ван Исюэ, Лю Мин, Бай Ҷяюэ ва Ли Вэн якҷо хӯрок мехӯранд."
      },
      "dialogue": [
        {
          "speaker": "王一雪",
          "zh": "服务员，再给我们拿一双筷子、一个勺子和一个碗。",
          "pinyin": "Fúwùyuán, zài gěi wǒmen ná yì shuāng kuàizi, yí ge sháozi hé yí ge wǎn.",
          "text": {
            "uz": "Ofitsiant, bizga yana bir juft cho‘pcha, bir qoshiq va bir kosa olib keling.",
            "ru": "Официант, принесите нам ещё одну пару палочек, ложку и миску.",
            "tj": "Пешхизмат, ба мо боз як ҷуфт чӯбча, як қошуқ ва як коса биёред."
          }
        },
        {
          "speaker": "服务员",
          "zh": "好的，请等一下，我马上去拿。",
          "pinyin": "Hǎo de, qǐng děng yíxià, wǒ mǎshàng qù ná.",
          "text": {
            "uz": "Xo‘p, biroz kuting, hozir olib kelaman.",
            "ru": "Хорошо, подождите немного, сейчас принесу.",
            "tj": "Хуб, каме интизор шавед, ҳозир меорам."
          }
        },
        {
          "speaker": "白家月",
          "zh": "哪个菜都好吃。您点的这些菜真不错。",
          "pinyin": "Nǎge cài dōu hǎochī. Nín diǎn de zhèxiē cài zhēn búcuò.",
          "text": {
            "uz": "Qaysi taomni olsak ham mazali. Siz buyurtma qilgan taomlar juda yaxshi ekan.",
            "ru": "Все блюда вкусные. То, что вы заказали, действительно отлично.",
            "tj": "Ҳар кадом хӯрок болаззат аст. Хӯрокҳое, ки шумо фармоиш додед, хеле хубанд."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Restoranda Wang Yixue, Liu Ming, Bai Jiayue va Li Wen ovqatlanib, suhbatni davom ettirmoqda.",
