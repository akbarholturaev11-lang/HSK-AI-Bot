    {
      "scene": {
        "uz": "Restoranda Yang Tongle hamkasblarini mehmon qilmoqda.",
        "ru": "В ресторане Ян Тунлэ угощает коллег.",
        "tj": "Дар тарабхона Ян Тунлэ ҳамкоронашро меҳмон мекунад."
      },
      "dialogue": [
        {
          "speaker": "杨同乐",
          "zh": "今天我请客，你们想吃什么就点什么！",
          "pinyin": "Jīntiān wǒ qǐngkè, nǐmen xiǎng chī shénme jiù diǎn shénme!",
          "text": {
            "uz": "Bugun men mehmon qilaman, nima yegingiz kelsa, o‘shani buyurtma qilinglar!",
            "ru": "Сегодня угощаю я, заказывайте что хотите!",
            "tj": "Имрӯз ман меҳмон мекунам, ҳар чӣ хоҳед фармоиш диҳед!"
          }
        },
        {
          "speaker": "王一雪",
          "zh": "那我就不客气了。听说这家饭馆的鱼做得很特别？",
          "pinyin": "Nà wǒ jiù bú kèqi le. Tīngshuō zhè jiā fànguǎn de yú zuò de hěn tèbié?",
          "text": {
            "uz": "Unda tortinmayman. Eshitishimcha, bu restoranda baliq o‘zgacha tayyorlanar ekan?",
            "ru": "Тогда церемониться не буду. Говорят, здесь рыбу готовят по-особому?",
            "tj": "Пас таоруф намекунам. Шунидам, ки дар ин тарабхона моҳиро махсус тайёр мекунанд?"
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "对，南方菜跟你们北方菜的做法不同。除了鱼，你们还想吃什么？",
          "pinyin": "Duì, nánfāng cài gēn nǐmen běifāng cài de zuòfǎ bù tóng. Chúle yú, nǐmen hái xiǎng chī shénme?",
          "text": {
            "uz": "Ha, janubiy taomlar shimoliy taomlardan boshqacha tayyorlanadi. Baliqdan tashqari yana nima yeysizlar?",
            "ru": "Да, южную кухню готовят иначе, чем северную. Кроме рыбы, что ещё хотите?",
            "tj": "Ҳа, таомҳои ҷанубӣ аз таомҳои шимолӣ дигар хел тайёр мешаванд. Ба ғайр аз моҳӣ боз чӣ мехоҳед?"
          }
        },
        {
          "speaker": "同事",
          "zh": "我不常吃南方菜，还是你决定吧。",
          "pinyin": "Wǒ bù cháng chī nánfāng cài, háishi nǐ juédìng ba.",
          "text": {
            "uz": "Men janubiy taomlarni tez-tez yemayman, yaxshisi sen tanla.",
            "ru": "Я редко ем южную кухню, лучше ты решай.",
            "tj": "Ман таомҳои ҷанубиро кам мехӯрам, беҳтараш худат интихоб кун."
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "好，那再加一个鸡肉，一个……",
          "pinyin": "Hǎo, nà zài jiā yí ge jīròu, yí ge...",
          "text": {
            "uz": "Xo‘p, unda yana bitta tovuqli taom, yana bitta...",
            "ru": "Хорошо, тогда добавим блюдо из курицы и ещё одно...",
            "tj": "Хуб, пас боз як хӯроки мурғӣ ва яктои дигар..."
          }
        },
        {
          "speaker": "王一雪",
          "zh": "咱们就三个人，别点那么多。",
          "pinyin": "Zánmen jiù sān ge rén, bié diǎn nàme duō.",
          "text": {
            "uz": "Biz atigi uch kishimiz, buncha ko‘p buyurtma qilma.",
            "ru": "Нас всего трое, не заказывай столько.",
            "tj": "Мо ҳамагӣ се нафарем, ин қадар зиёд фармоиш надиҳ."
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "好，那先来这几个菜。",
          "pinyin": "Hǎo, nà xiān lái zhè jǐ ge cài.",
          "text": {
            "uz": "Xo‘p, avval shu taomlarni olamiz.",
            "ru": "Хорошо, тогда пока эти блюда.",
            "tj": "Хуб, ҳоло ҳамин чанд хӯрокро гирем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Uyda Wang Yixue va Liu Ming tug‘ilgan kun bazmiga tayyorlanmoqda.",
        "ru": "Дома Ван Исюэ и Лю Мин готовятся к дню рождения.",
        "tj": "Дар хона Ван Исюэ ва Лю Мин ба ҷашни зодрӯз омодагӣ мебинанд."
      },
      "dialogue": [
        {
          "speaker": "王一雪",
          "zh": "第一次请新邻居来做客，总是担心有什么没准备好。",
          "pinyin": "Dì yí cì qǐng xīn línjū lái zuòkè, zǒngshì dānxīn yǒu shénme méi zhǔnbèi hǎo.",
          "text": {
            "uz": "Yangi qo‘shnilarni birinchi marta mehmonga chaqiryapmiz, nimanidir tayyorlamay qolmadikmi deb xavotirdaman.",
            "ru": "Впервые приглашаем новых соседей, всё переживаю, не забыли ли что-то подготовить.",
            "tj": "Бори аввал ҳамсояҳои навро меҳмон мекунем, ҳамеша хавотирам, ки чизе тайёр нашуда бошад."
          }
        },
        {
          "speaker": "刘明",
          "zh": "放心吧，我帮你看了，都已经准备好了。",
          "pinyin": "Fàngxīn ba, wǒ bāng nǐ kàn le, dōu yǐjīng zhǔnbèi hǎo le.",
          "text": {
            "uz": "Xotirjam bo‘l, tekshirib chiqdim, hammasi tayyor.",
            "ru": "Не переживай, я всё проверил, всё готово.",
            "tj": "Хотирҷамъ бош, ман санҷидам, ҳама чиз тайёр аст."
          }
        },
        {
          "speaker": "王一雪",
          "zh": "音乐的声音合适吗？",
          "pinyin": "Yīnyuè de shēngyīn héshì ma?",
          "text": {
            "uz": "Musiqa ovozi mosmi?",
            "ru": "Громкость музыки нормальная?",
            "tj": "Баландии мусиқӣ мувофиқ аст?"
          }
        },
        {
          "speaker": "刘明",
          "zh": "你把声音开得太大了，我去关小一点儿。",
          "pinyin": "Nǐ bǎ shēngyīn kāi de tài dà le, wǒ qù guān xiǎo yìdiǎnr.",
          "text": {
            "uz": "Ovozni juda baland qilibsan, men biroz pasaytiraman.",
            "ru": "Ты сделал слишком громко, я немного убавлю.",
            "tj": "Ту садоро хеле баланд кардӣ, ман каме паст мекунам."
