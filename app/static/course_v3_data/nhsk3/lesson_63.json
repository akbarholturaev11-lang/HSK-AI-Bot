  "dialogues": [
    {
      "scene": {
        "uz": "Maktab sport zalida Li Wen Chen Tianzhongni uchratdi.",
        "ru": "В школьном спортзале Ли Вэнь встретил Чэнь Тяньчжуна.",
        "tj": "Дар толори варзишии мактаб Ли Вэн бо Чэн Тянҷун вохӯрд."
      },
      "dialogue": [
        {
          "speaker": "李文",
          "zh": "你的运动习惯真不错。",
          "pinyin": "Nǐ de yùndòng xíguàn zhēn búcuò.",
          "text": {
            "uz": "Sport odating juda yaxshi ekan.",
            "ru": "У тебя отличная спортивная привычка.",
            "tj": "Одати варзишиат хеле хуб аст."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "因为我今年胖了十多斤，不能再胖下去了，有点儿不健康。",
          "pinyin": "Yīnwèi wǒ jīnnián pàng le shí duō jīn, bù néng zài pàng xiàqu le, yǒudiǎnr bù jiànkāng.",
          "text": {
            "uz": "Chunki bu yil o‘n jindan ko‘proq semirdim, yana semirish mumkin emas, bu sog‘lom emas.",
            "ru": "Потому что в этом году я набрал больше десяти цзиней. Дальше толстеть нельзя, это уже нездорово.",
            "tj": "Чунки имсол зиёда аз даҳ ҷин фарбеҳ шудам, дигар набояд фарбеҳ шавам, ин каме носолим аст."
          }
        },
        {
          "speaker": "李文",
          "zh": "我下课以后常去打羽毛球，你也来玩吧。",
          "pinyin": "Wǒ xiàkè yǐhòu cháng qù dǎ yǔmáoqiú, nǐ yě lái wán ba.",
          "text": {
            "uz": "Men darsdan keyin tez-tez badminton o‘ynayman, sen ham kel.",
            "ru": "После занятий я часто играю в бадминтон, приходи тоже.",
            "tj": "Ман баъди дарс зуд-зуд бадминтон бозӣ мекунам, ту ҳам биё."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "我知道，但是你们的水平太高了，我打得不怎么样。",
          "pinyin": "Wǒ zhīdào, dànshì nǐmen de shuǐpíng tài gāo le, wǒ dǎ de bù zěnmeyàng.",
          "text": {
            "uz": "Bilaman, lekin sizlarning darajangiz juda yuqori, men uncha yaxshi o‘ynamayman.",
            "ru": "Знаю, но у вас слишком высокий уровень, а я играю не очень.",
            "tj": "Медонам, аммо сатҳи шумо хеле баланд аст, ман он қадар хуб бозӣ намекунам."
          }
        },
        {
          "speaker": "李文",
          "zh": "没关系，我可以教你。",
          "pinyin": "Méi guānxi, wǒ kěyǐ jiāo nǐ.",
          "text": {
            "uz": "Hechqisi yo‘q, men senga o‘rgataman.",
            "ru": "Ничего, я могу тебя научить.",
            "tj": "Ҳеҷ гап нест, ман метавонам ба ту омӯзонам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Sinfda Annie Chen Tianzhongning holidan xabar olmoqda.",
        "ru": "В классе Энни спрашивает Чэнь Тяньчжуна о самочувствии.",
        "tj": "Дар синф Энни аҳволи Чэн Тянҷунро мепурсад."
      },
      "dialogue": [
        {
          "speaker": "安妮",
          "zh": "你怎么了？看上去有点儿不舒服。",
          "pinyin": "Nǐ zěnme le? Kàn shàngqu yǒudiǎnr bù shūfu.",
          "text": {
            "uz": "Senga nima bo‘ldi? O‘zingni biroz yomon his qilayotgandek ko‘rinyapsan.",
            "ru": "Что с тобой? Выглядишь так, будто тебе нехорошо.",
            "tj": "Ба ту чӣ шуд? Ба назар каме худро бад ҳис мекунӣ."
          }
        },
        {
          "speaker": "安妮",
          "zh": "是不是感冒了？发烧吗？",
          "pinyin": "Shì bú shì gǎnmào le? Fāshāo ma?",
          "text": {
            "uz": "Shamolladingmi? Isitmang bormi?",
            "ru": "Ты простудился? Температура есть?",
            "tj": "Шамол хӯрдӣ? Таб дорӣ?"
          }
        },
        {
          "speaker": "安妮",
          "zh": "我送你去医院，让医生检查一下吧。",
          "pinyin": "Wǒ sòng nǐ qù yīyuàn, ràng yīshēng jiǎnchá yíxià ba.",
          "text": {
            "uz": "Men seni shifoxonaga olib boraman, shifokor tekshirib ko‘rsin.",
            "ru": "Я отвезу тебя в больницу, пусть врач осмотрит.",
            "tj": "Ман туро ба беморхона мебарам, бигзор духтур муоина кунад."
          }
        },
        {
          "speaker": "安妮",
          "zh": "好吧，如果下午还发烧，就一定要去看医生。",
          "pinyin": "Hǎo ba, rúguǒ xiàwǔ hái fāshāo, jiù yídìng yào qù kàn yīshēng.",
          "text": {
            "uz": "Mayli, agar tushdan keyin ham isitma bo‘lsa, albatta shifokorga bor.",
            "ru": "Хорошо. Если днём температура останется, обязательно иди к врачу.",
            "tj": "Хуб, агар баъд аз нисфирӯзӣ ҳам таб дошта бошӣ, ҳатман ба духтур рав."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "谢谢关心，我会注意的。",
          "pinyin": "Xièxie guānxīn, wǒ huì zhùyì de.",
          "text": {
            "uz": "G‘amxo‘rliging uchun rahmat, e’tibor beraman.",
            "ru": "Спасибо за заботу, я буду внимателен.",
            "tj": "Раҳмат барои ғамхорӣ, эҳтиёт мекунам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Shifoxona palatasida Annie Chen Tianzhongni ko‘rgani keldi.",
        "ru": "В больничной палате Энни пришла навестить Чэнь Тяньчжуна.",
        "tj": "Дар палатаи беморхона Энни барои дидани Чэн Тянҷун омадааст."
      },
      "dialogue": [
        {
          "speaker": "安妮",
          "zh": "你怎么突然住院了？大家都很担心你。",
          "pinyin": "Nǐ zěnme tūrán zhùyuàn le? Dàjiā dōu hěn dānxīn nǐ.",
          "text": {
            "uz": "Nega birdan shifoxonaga yotib qolding? Hamma sendan xavotirda.",
            "ru": "Почему ты вдруг попал в больницу? Все за тебя переживают.",
            "tj": "Чаро ногаҳон дар беморхона бистарӣ шудӣ? Ҳама барои ту хавотиранд."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "我的腿疼了几个星期了，医生说需要住院做检查。",
          "pinyin": "Wǒ de tuǐ téng le jǐ ge xīngqī le, yīshēng shuō xūyào zhùyuàn zuò jiǎnchá.",
          "text": {
            "uz": "Oyog‘im bir necha haftadan beri og‘riyapti, shifokor tekshiruv uchun yotishim kerakligini aytdi.",
            "ru": "Нога болит уже несколько недель, врач сказал, что нужно лечь в больницу на обследование.",
            "tj": "Поям чанд ҳафта боз дард мекунад, духтур гуфт барои санҷиш бояд бистарӣ шавам."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "是啊，我很少生病。我上次来医院已经过去差不多两年了。",
          "pinyin": "Shì a, wǒ hěn shǎo shēngbìng. Wǒ shàng cì lái yīyuàn yǐjīng guòqu chàbuduō liǎng nián le.",
          "text": {
            "uz": "Ha, men kam kasal bo‘laman. Shifoxonaga oxirgi kelganimga deyarli ikki yil bo‘ldi.",
            "ru": "Да, я редко болею. С прошлого визита в больницу прошло почти два года.",
            "tj": "Ҳа, ман кам бемор мешавам. Аз бори охир ба беморхона омаданам қариб ду сол гузашт."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "医生也这么说，但是还得做完检查才能知道。",
          "pinyin": "Yīshēng yě zhème shuō, dànshì hái děi zuò wán jiǎnchá cái néng zhīdào.",
          "text": {
            "uz": "Shifokor ham shunday dedi, lekin aniq bilish uchun tekshiruvni tugatish kerak.",
            "ru": "Врач тоже так сказал, но узнать точно можно только после обследования.",
            "tj": "Духтур ҳам ҳаминро гуфт, аммо танҳо баъди анҷоми санҷиш маълум мешавад."
          }
        },
        {
          "speaker": "陈天中",
          "zh": "谢谢。有人来看我，我就开心多了。",
          "pinyin": "Xièxie. Yǒu rén lái kàn wǒ, wǒ jiù kāixīn duō le.",
          "text": {
            "uz": "Rahmat. Kimdir meni ko‘rgani kelsa, ancha xursand bo‘laman.",
            "ru": "Спасибо. Когда кто-то приходит меня навестить, мне намного веселее.",
            "tj": "Раҳмат. Вақте касе ба диданам меояд, хеле хурсандтар мешавам."
          }
        }
      ]
    }
