  "dialogues": [
    {
      "scene": {
        "uz": "Wang Yifeining uyida Yang Tongle va Wang Yifei mehmonxonada suhbatlashmoqda.",
        "ru": "В гостиной у Ван Ифэй Ян Тунлэ и Ван Ифэй разговаривают.",
        "tj": "Дар меҳмонхонаи Ван Ифэй Ян Тунлэ ва Ван Ифэй суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "杨同乐",
          "zh": "这个假期咱们去哪儿玩玩吧。",
          "pinyin": "Zhège jiàqī zánmen qù nǎr wánwan ba.",
          "text": {
            "uz": "Bu ta’tilda biror joyga sayrga boraylik.",
            "ru": "Давай куда-нибудь съездим на этих каникулах.",
            "tj": "Дар ин таътил биё ба ягон ҷо сайр равем."
          }
        },
        {
          "speaker": "王一飞",
          "zh": "好啊，你想去哪儿，咱们就去哪儿。",
          "pinyin": "Hǎo a, nǐ xiǎng qù nǎr, zánmen jiù qù nǎr.",
          "text": {
            "uz": "Mayli, qayerga borishni xohlasang, o‘sha yerga boramiz.",
            "ru": "Хорошо, куда ты захочешь, туда и поедем.",
            "tj": "Хуб, ба куҷо хоҳӣ, ҳамон ҷо меравем."
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "你喜欢海，找个海边住几天，怎么样？",
          "pinyin": "Nǐ xǐhuan hǎi, zhǎo ge hǎibiān zhù jǐ tiān, zěnmeyàng?",
          "text": {
            "uz": "Sen dengizni yoqtirasan, dengiz bo‘yida bir necha kun yashasak qanday?",
            "ru": "Ты любишь море. Может, поживём несколько дней у моря?",
            "tj": "Ту баҳрро дӯст медорӣ, чанд рӯз дар соҳил зиндагӣ кунем чӣ хел?"
          }
        },
        {
          "speaker": "王一飞",
          "zh": "现在去海边有点儿冷。",
          "pinyin": "Xiànzài qù hǎibiān yǒudiǎnr lěng.",
          "text": {
            "uz": "Hozir dengiz bo‘yiga borish biroz sovuq.",
            "ru": "Сейчас на море немного холодно.",
            "tj": "Ҳоло ба соҳил рафтан каме хунук аст."
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "那去草原吧？草原一点儿也不冷。",
          "pinyin": "Nà qù cǎoyuán ba? Cǎoyuán yìdiǎnr yě bù lěng.",
          "text": {
            "uz": "Unda dashtga boramizmi? Dasht umuman sovuq emas.",
            "ru": "Тогда поедем в степь? Там совсем не холодно.",
            "tj": "Пас ба саҳро равем? Он ҷо тамоман хунук нест."
          }
        },
        {
          "speaker": "王一飞",
          "zh": "这个主意好！我好久没骑马了。",
          "pinyin": "Zhège zhǔyi hǎo! Wǒ hǎojiǔ méi qí mǎ le.",
          "text": {
            "uz": "Bu yaxshi fikr! Anchadan beri ot minmaganman.",
            "ru": "Хорошая идея! Я давно не ездил верхом.",
            "tj": "Ин фикр хуб аст! Кайҳо аспсаворӣ накардаам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Wang Yifeining uyida Yang Tongle va Wang Yifei mehmonxonada suhbatlashmoqda.",
        "ru": "В гостиной у Ван Ифэй Ян Тунлэ и Ван Ифэй разговаривают.",
        "tj": "Дар меҳмонхонаи Ван Ифэй Ян Тунлэ ва Ван Ифэй суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "杨同乐",
          "zh": "出去玩的机票买好了吗？",
          "pinyin": "Chūqù wán de jīpiào mǎi hǎo le ma?",
          "text": {
            "uz": "Sayohat uchun aviachiptalarni olib bo‘ldingmi?",
            "ru": "Билеты на поездку уже куплены?",
            "tj": "Чиптаҳои сафарро харида шуд?"
          }
        },
        {
          "speaker": "杨同乐",
          "zh": "太好了！你看看要带什么东西？",
          "pinyin": "Tài hǎo le! Nǐ kànkan yào dài shénme dōngxi?",
          "text": {
            "uz": "Zo‘r! Qara, nimalarni olib borish kerak?",
            "ru": "Отлично! Посмотри, что нужно взять с собой.",
            "tj": "Олиҷаноб! Бин, чӣ чизҳоро бояд бо худ гирем?"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Aeroportda Yang Tongle va Wang Yifei tashqariga chiqib, oldindan buyurtma qilingan haydovchi-gid bilan uchrashmoqda.",
        "ru": "В аэропорту Ян Тунлэ и Ван Ифэй выходят и встречаются с заранее заказанным водителем-гидом.",
        "tj": "Дар фурудгоҳ Ян Тунлэ ва Ван Ифэй берун омада, бо ронанда-роҳбалади пешакӣ фармоишдода вохӯрданд."
      },
      "dialogue": [
        {
          "speaker": "杨同乐",
          "zh": "还有一个包，我自己拿就可以。",
          "pinyin": "Hái yǒu yí ge bāo, wǒ zìjǐ ná jiù kěyǐ.",
          "text": {
            "uz": "Yana bitta sumka bor, uni o‘zim olaman.",
            "ru": "Есть ещё одна сумка, её я понесу сам.",
            "tj": "Боз як халта ҳаст, худам мебардорам."
          }
        },
        {
          "speaker": "小李",
          "zh": "车在一层，请跟我来。",
          "pinyin": "Chē zài yì céng, qǐng gēn wǒ lái.",
          "text": {
            "uz": "Mashina birinchi qavatda, ortimdan yuringlar.",
            "ru": "Машина на первом этаже, идите за мной.",
            "tj": "Мошин дар ошёнаи якум аст, аз паси ман биёед."
