  "dialogues": [
    {
      "scene": {
        "uz": "Aeroportda Li Wen va Bai Jiayue bagaj olish joyida.",
        "ru": "В аэропорту Ли Вэнь и Бай Цзяюэ находятся у выдачи багажа.",
        "tj": "Дар фурудгоҳ Ли Вэн ва Бай Ҷяюэ дар ҷойи гирифтани бағоҷ ҳастанд."
      },
      "dialogue": [
        {
          "speaker": "白家月",
          "zh": "是一个黑色的箱子，上面写着我的名字和电话号码。",
          "pinyin": "Shì yí ge hēisè de xiāngzi, shàngmian xiězhe wǒ de míngzi hé diànhuà hàomǎ.",
          "text": {
            "uz": "Qora chamadon, ustida ismim va telefon raqamim yozilgan.",
            "ru": "Это чёрный чемодан, на нём написаны моё имя и номер телефона.",
            "tj": "Ҷомадони сиёҳ аст, рӯяш ному рақами телефонам навишта шудааст."
          }
        },
        {
          "speaker": "李文",
          "zh": "我好像在哪儿看到过这个箱子，是不是有人拿错了？",
          "pinyin": "Wǒ hǎoxiàng zài nǎr kàndào guo zhège xiāngzi, shì bú shì yǒu rén ná cuò le?",
          "text": {
            "uz": "Bu chamadonni qayerdadir ko‘rgandekman, balki kimdir adashib olib ketgandir?",
            "ru": "Кажется, я где-то видел этот чемодан. Может, кто-то взял его по ошибке?",
            "tj": "Ба назарам, ин ҷомадонро дар ягон ҷо дида будам. Шояд касе иштибоҳан гирифта бошад?"
          }
        },
        {
          "speaker": "白家月",
          "zh": "我们快找谁问一下吧，箱子里有不少重要的东西。",
          "pinyin": "Wǒmen kuài zhǎo shéi wèn yíxià ba, xiāngzi lǐ yǒu bù shǎo zhòngyào de dōngxi.",
          "text": {
            "uz": "Tezroq biror kishidan so‘raylik, chamadonda ancha muhim narsalar bor.",
            "ru": "Давай скорее у кого-нибудь спросим: в чемодане много важных вещей.",
            "tj": "Биё зуд аз касе пурсем, дар ҷомадон чизҳои муҳими зиёд ҳастанд."
          }
        },
        {
          "speaker": "李文",
          "zh": "别着急，我们拿着护照和机票，去服务台问问吧。",
          "pinyin": "Bié zháojí, wǒmen názhe hùzhào hé jīpiào, qù fúwùtái wènwen ba.",
          "text": {
            "uz": "Xavotir olma, pasport va chiptalarimiz yonimizda, xizmat ko‘rsatish peshtaxtasiga borib so‘raylik.",
            "ru": "Не волнуйся. Паспорт и билеты у нас с собой, пойдём спросим на стойке обслуживания.",
            "tj": "Ташвиш накаш, шиноснома ва чиптаҳо бо мост, биё ба мизи хизматрасонӣ рафта пурсем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Aeroport zalida Liu Ming va Wang Yixue mehmonlarni kutib olmoqda.",
        "ru": "В зале аэропорта Лю Мин и Ван Исюэ встречают прилетающих.",
        "tj": "Дар толори фурудгоҳ Лю Мин ва Ван Исюэ меҳмононро пешвоз мегиранд."
      },
      "dialogue": [
        {
          "speaker": "刘明",
          "zh": "我们站到中间去吧，这样他们好找一些。",
          "pinyin": "Wǒmen zhàn dào zhōngjiān qù ba, zhèyàng tāmen hǎo zhǎo yìxiē.",
          "text": {
            "uz": "O‘rtaroqqa borib turaylik, shunda ular bizni osonroq topadi.",
            "ru": "Давай встанем посередине, так им будет легче нас найти.",
            "tj": "Биё дар миёна истем, ҳамин тавр моро осонтар меёбанд."
          }
        }
      ]
    }
  ],
