  "dialogues": [
    {
      "scene": {
        "uz": "Samolyotda Bai Jiayue va Li Wen suhbatlashmoqda.",
        "ru": "В самолёте Бай Цзяюэ и Ли Вэнь разговаривают.",
        "tj": "Дар ҳавопаймо Бай Ҷяюэ ва Ли Вэн суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "白家月",
          "zh": "你们怎样过节？",
          "pinyin": "Nǐmen zěnyàng guòjié?",
          "text": {
            "uz": "Sizlar bayramni qanday nishonlaysizlar?",
            "ru": "Как вы отмечаете праздник?",
            "tj": "Шумо идро чӣ тавр ҷашн мегиред?"
          }
        },
        {
          "speaker": "白家月",
          "zh": "那你跟家人会一起做什么？",
          "pinyin": "Nà nǐ gēn jiārén huì yìqǐ zuò shénme?",
          "text": {
            "uz": "Unda oilang bilan birga nimalar qilasizlar?",
            "ru": "А что вы обычно делаете вместе с семьёй?",
            "tj": "Пас бо оилаатон якҷо чӣ кор мекунед?"
          }
        },
        {
          "speaker": "李文",
          "zh": "大概七八天。",
          "pinyin": "Dàgài qī bā tiān.",
          "text": {
            "uz": "Taxminan yetti-sakkiz kun.",
            "ru": "Примерно семь-восемь дней.",
            "tj": "Тақрибан ҳафт-ҳашт рӯз."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Li Wenning uyida Bai Jiayue uning ota-onasini Yangi yil bilan tabriklamoqda.",
        "ru": "Дома у Ли Вэня Бай Цзяюэ поздравляет его родителей с Новым годом.",
        "tj": "Дар хонаи Ли Вэн Бай Ҷяюэ падару модари ӯро бо Соли нав табрик мекунад."
      },
      "dialogue": [
        {
          "speaker": "李叔叔",
          "zh": "谢谢家月，你太客气了！",
          "pinyin": "Xièxie Jiāyuè, nǐ tài kèqi le!",
          "text": {
            "uz": "Rahmat, Jiayue, juda ovora bo‘libsan!",
            "ru": "Спасибо, Цзяюэ, не стоило так церемониться!",
            "tj": "Раҳмат, Ҷяюэ, ин қадар таоруф лозим набуд!"
          }
        },
        {
          "speaker": "白家月",
          "zh": "谢谢您和叔叔请我来家里做客。",
          "pinyin": "Xièxie nín hé shūshu qǐng wǒ lái jiālǐ zuòkè.",
          "text": {
            "uz": "Meni uyingizga mehmonga taklif qilganingiz uchun sizga va amakiga rahmat.",
            "ru": "Спасибо вам и дяде, что пригласили меня в гости.",
            "tj": "Раҳмат ба шумо ва амак, ки маро ба хона меҳмон даъват кардед."
          }
        },
        {
          "speaker": "李叔叔",
          "zh": "桌子上有饮料，还有矿泉水，你想喝什么就自己拿。",
          "pinyin": "Zhuōzi shàng yǒu yǐnliào, hái yǒu kuàngquánshuǐ, nǐ xiǎng hē shénme jiù zìjǐ ná.",
          "text": {
            "uz": "Stolda ichimliklar va mineral suv bor, nimani ichging kelsa o‘zing olaver.",
            "ru": "На столе напитки и минеральная вода, бери сама что хочешь.",
            "tj": "Рӯйи миз нӯшокиҳо ва оби маъданӣ ҳаст, ҳар чӣ хоҳӣ худат бигир."
          }
        },
        {
          "speaker": "白家月",
          "zh": "我刚刚看视频学会了包饺子，我跟你们一起包吧。",
          "pinyin": "Wǒ gānggāng kàn shìpín xuéhuì le bāo jiǎozi, wǒ gēn nǐmen yìqǐ bāo ba.",
          "text": {
            "uz": "Men hozirgina videodan jiaozi tugishni o‘rgandim, sizlar bilan birga qilay.",
            "ru": "Я только что по видео научилась лепить цзяоцзы, давайте я помогу вам.",
            "tj": "Ман ҳозиргина аз видео ҷяози печониданро омӯхтам, бо шумо якҷо мекунам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Li Wenning uyida uning onasi va Bai Jiayue suhbatlashmoqda.",
        "ru": "Дома у Ли Вэня его мама и Бай Цзяюэ разговаривают.",
        "tj": "Дар хонаи Ли Вэн модараш ва Бай Ҷяюэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "白家月",
          "zh": "那是三四年前吧？",
          "pinyin": "Nà shì sān sì nián qián ba?",
          "text": {
            "uz": "Bu uch-to‘rt yil oldin bo‘lgan-a?",
            "ru": "Это было года три-четыре назад, да?",
            "tj": "Ин се-чор сол пеш буд, дуруст?"
          }
        },
        {
          "speaker": "张阿姨",
          "zh": "是啊，时间过得真快，好像是不久前发生的一样。",
          "pinyin": "Shì a, shíjiān guò de zhēn kuài, hǎoxiàng shì bùjiǔ qián fāshēng de yíyàng.",
          "text": {
            "uz": "Ha, vaqt juda tez o‘tadi, xuddi yaqindagina bo‘lgandek.",
            "ru": "Да, время летит быстро, кажется, будто это случилось совсем недавно.",
            "tj": "Ҳа, вақт хеле зуд мегузарад, гӯё ҳамин наздикӣ рӯй дода бошад."
          }
        },
        {
          "speaker": "张阿姨",
          "zh": "他刚离开家时，我很不习惯，只要几天不跟他视频，就很想他。",
          "pinyin": "Tā gāng líkāi jiā shí, wǒ hěn bù xíguàn, zhǐyào jǐ tiān bù gēn tā shìpín, jiù hěn xiǎng tā.",
          "text": {
            "uz": "U endi uyidan ketgan paytda juda ko‘nika olmagandim; bir necha kun video orqali gaplashmasak, darrov sog‘inardim.",
            "ru": "Когда он только уехал из дома, мне было непривычно: стоило несколько дней не созваниваться по видео, я очень скучала.",
            "tj": "Вақте ӯ нав аз хона рафт, бароям хеле ғайриодатӣ буд; чанд рӯз видео суҳбат накунем, сахт пазмонаш мешавам."
          }
        },
        {
          "speaker": "白家月",
          "zh": "还有最后一个学期就要毕业了，他很快就会回来了。",
          "pinyin": "Hái yǒu zuìhòu yí ge xuéqī jiù yào bìyè le, tā hěn kuài jiù huì huílái le.",
          "text": {
            "uz": "Faqat oxirgi bir semestr qoldi, keyin bitiradi va tez orada qaytadi.",
            "ru": "Остался последний семестр до выпуска, скоро он вернётся.",
            "tj": "Танҳо як семестри охир мондааст, баъд хатм мекунад ва зуд бармегардад."
          }
        }
      ]
    }
  ],
