      "dialogue": [
        {
          "speaker": "Liu Ming",
          "zh": "小雪，生日快乐！",
          "pinyin": "Xiǎoxuě, shēngrì kuàilè!",
          "text": {
            "uz": "Xiaoxue, tug‘ilgan kuning bilan!",
