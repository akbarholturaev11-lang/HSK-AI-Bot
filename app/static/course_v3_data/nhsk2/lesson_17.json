        },
        {
          "speaker": "Liu Xiaoxue",
          "zh": "因为我喜欢白色啊！",
          "pinyin": "Yīnwèi wǒ xǐhuan báisè a!",
          "text": {
            "uz": "Chunki men oq rangni yoqtiraman!",
            "ru": "Потому что мне нравится белый!",
            "tj": "Зеро ман ранги сафедро дӯст медорам!"
          }
        }
      ]
    }
