      "dialogue": [
        {
          "speaker": "Liu Xiaoxue",
          "zh": "妈妈，我想买这条白色的裤子。",
          "pinyin": "Māma, wǒ xiǎng mǎi zhè tiáo báisè de kùzi.",
          "text": {
            "uz": "Oyi, men mana bu oq shimni olmoqchiman.",
            "ru": "Мама, я хочу купить эти белые брюки.",
