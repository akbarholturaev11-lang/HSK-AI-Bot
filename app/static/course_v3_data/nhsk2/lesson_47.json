        {
          "speaker": "Liu Xiaoming",
          "zh": "好！",
          "pinyin": "Hǎo!",
          "text": {
            "uz": "Xo‘p!",
            "ru": "Хорошо!",
            "tj": "Хуб!"
          }
        }
      ]
    },
