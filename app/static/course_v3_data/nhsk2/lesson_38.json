  "dialogues": [
    {
      "scene": {
        "uz": "Savdo markazida Wang Yixue va Liu Ming xarid qilmoqda.",
        "ru": "В торговом центре Ван Исюэ и Лю Мин делают покупки.",
        "tj": "Дар маркази савдо Ван Исюэ ва Лю Мин харид мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "你看，这两块手表怎么样？",
          "pinyin": "Nǐ kàn, zhè liǎng kuài shǒubiǎo zěnmeyàng?",
          "text": {
            "uz": "Qara, bu ikki qo‘l soati qanday?",
            "ru": "Посмотри, как тебе эти двое часов?",
            "tj": "Бин, ин ду соат чӣ хеланд?"
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "都不错！",
          "pinyin": "Dōu búcuò!",
          "text": {
            "uz": "Ikkalasi ham yomon emas!",
            "ru": "Оба неплохие!",
            "tj": "Ҳардуяш ҳам бад нест!"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "我喜欢左边这个。",
          "pinyin": "Wǒ xǐhuan zuǒbian zhège.",
          "text": {
            "uz": "Menga chapdagisi yoqdi.",
            "ru": "Мне нравится тот, что слева.",
            "tj": "Ба ман тарафи чап писанд аст."
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "我也觉得左边的比右边的好看。",
          "pinyin": "Wǒ yě juéde zuǒbian de bǐ yòubian de hǎokàn.",
          "text": {
            "uz": "Menimcha ham chapdagisi o‘ngdagidan chiroyliroq.",
            "ru": "Мне тоже кажется, что левый красивее правого.",
            "tj": "Ба назари ман ҳам чапаш аз росташ зеботар аст."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "你看看要多少钱！",
          "pinyin": "Nǐ kànkan yào duōshao qián!",
          "text": {
            "uz": "Narxiga qara!",
            "ru": "Посмотри, сколько стоит!",
            "tj": "Нархашро бин!"
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "真不便宜！八千八！",
          "pinyin": "Zhēn bù piányi! Bā qiān bā!",
          "text": {
            "uz": "Juda qimmat ekan! Sakkiz ming sakkiz yuz!",
            "ru": "Совсем недёшево! Восемь тысяч восемьсот!",
            "tj": "Хеле гарон будааст! Ҳашт ҳазору ҳаштсад!"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Kinoteatr tashqarisida Wang Yixue va Liu Ming suhbatlashmoqda.",
        "ru": "Снаружи кинотеатра Ван Исюэ и Лю Мин разговаривают.",
        "tj": "Берун аз кинотеатр Ван Исюэ ва Лю Мин суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Liu Ming",
          "zh": "今天有不少电影，我们看个电影吧。",
          "pinyin": "Jīntiān yǒu bù shǎo diànyǐng, wǒmen kàn ge diànyǐng ba.",
          "text": {
            "uz": "Bugun ancha film bor, bir film ko‘raylik.",
            "ru": "Сегодня много фильмов, давай посмотрим один.",
            "tj": "Имрӯз филмҳо бисёранд, биё як филм бинем."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "好啊！我们看哪个？",
          "pinyin": "Hǎo a! Wǒmen kàn nǎge?",
          "text": {
            "uz": "Mayli! Qaysinisini ko‘ramiz?",
            "ru": "Хорошо! Какой посмотрим?",
            "tj": "Хуб! Кадомашро мебинем?"
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "我记得你喜欢看爱情片，我们看那个爱情片，怎么样？",
          "pinyin": "Wǒ jìde nǐ xǐhuan kàn àiqíngpiàn, wǒmen kàn nàge àiqíngpiàn, zěnmeyàng?",
          "text": {
            "uz": "Esimda, sen romantik filmlarni yoqtirasan. O‘sha romantik filmni ko‘rsak qanday?",
            "ru": "Я помню, ты любишь романтические фильмы. Как насчёт того?",
            "tj": "Дар хотир дорам, ту филмҳои ошиқонаро дӯст медорӣ. Он филмро бинем, чӣ хел?"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "还是看这个吧，我看网上说这个电影比那个爱情片更有意思。",
          "pinyin": "Háishi kàn zhège ba, wǒ kàn wǎngshang shuō zhège diànyǐng bǐ nàge àiqíngpiàn gèng yǒu yìsi.",
          "text": {
            "uz": "Yaxshisi bunisini ko‘raylik. Internetda bu film o‘sha romantik filmdan qiziqroq deyilgan.",
            "ru": "Лучше посмотрим этот. В интернете пишут, что он интереснее того романтического.",
            "tj": "Беҳтараш ҳаминро бинем. Дар интернет гуфтаанд, ки ин аз он филми ошиқона ҷолибтар аст."
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "好。我去买票。",
          "pinyin": "Hǎo. Wǒ qù mǎi piào.",
          "text": {
            "uz": "Xo‘p. Men chipta olaman.",
            "ru": "Хорошо. Я куплю билеты.",
            "tj": "Хуб. Ман чипта мехарам."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "到网上买吧，网上买比在这里买便宜。",
          "pinyin": "Dào wǎngshang mǎi ba, wǎngshang mǎi bǐ zài zhèlǐ mǎi piányi.",
          "text": {
            "uz": "Internetdan ol, onlayn olish bu yerdan olishdan arzonroq.",
            "ru": "Купи онлайн, в интернете дешевле, чем здесь.",
            "tj": "Аз интернет бихар, онлайниаш аз ин ҷо арзонтар аст."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Restoranda Wang Yixue va Liu Ming taom buyurtma qilmoqda.",
        "ru": "В ресторане Ван Исюэ и Лю Мин заказывают блюда.",
        "tj": "Дар тарабхона Ван Исюэ ва Лю Мин хӯрок фармоиш медиҳанд."
      },
      "dialogue": [
        {
          "speaker": "Liu Ming",
          "zh": "您好！就要这几个菜吧，谢谢！",
          "pinyin": "Nín hǎo! Jiù yào zhè jǐ ge cài ba, xièxie!",
          "text": {
            "uz": "Salom! Shu bir nechta taomni olamiz, rahmat!",
            "ru": "Здравствуйте! Возьмём эти блюда, спасибо!",
            "tj": "Салом! Ҳамин чанд хӯрокро мегирем, раҳмат!"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "怎么点这么多菜？",
          "pinyin": "Zěnme diǎn zhème duō cài?",
          "text": {
            "uz": "Nega buncha ko‘p taom buyurtma qilding?",
            "ru": "Зачем заказал столько блюд?",
            "tj": "Чаро ин қадар хӯрок фармоиш додӣ?"
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "你想想，今天是几月几号？",
          "pinyin": "Nǐ xiǎngxiang, jīntiān shì jǐ yuè jǐ hào?",
          "text": {
            "uz": "O‘ylab ko‘r, bugun nechanchi sana?",
            "ru": "Подумай, какое сегодня число?",
            "tj": "Фикр кун, имрӯз чандуми моҳ аст?"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "8月27号。啊！我的生日！",
          "pinyin": "Bā yuè èrshíqī hào. A! Wǒ de shēngrì!",
          "text": {
            "uz": "27-avgust. Voy! Tug‘ilgan kunim!",
            "ru": "27 августа. А! Мой день рождения!",
            "tj": "27-уми август. Оҳ! Зодрӯзи ман!"
          }
        }
      ]
    }
