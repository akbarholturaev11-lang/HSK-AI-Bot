  "dialogues": [
    {
      "scene": {
        "uz": "Mehmonxona pastida Annie Bai Jiayuega telefon qilmoqda.",
        "ru": "Внизу гостиницы Энни звонит Бай Цзяюэ.",
        "tj": "Дар поёни меҳмонхона Энни ба Бай Ҷяюэ занг мезанад."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue",
          "zh": "还有时间，你上来吧。",
          "pinyin": "Hái yǒu shíjiān, nǐ shànglái ba.",
          "text": {
            "uz": "Hali vaqt bor, sen yuqoriga chiq.",
            "ru": "Время ещё есть, поднимайся ко мне.",
            "tj": "Ҳоло вақт ҳаст, ту боло биё."
          }
        },
        {
          "speaker": "Annie",
          "zh": "我不上去了，就在下面等你。",
          "pinyin": "Wǒ bú shàngqù le, jiù zài xiàmian děng nǐ.",
          "text": {
            "uz": "Men yuqoriga chiqmayman, pastda seni kutaman.",
            "ru": "Я не буду подниматься, подожду тебя внизу.",
            "tj": "Ман боло намебароям, дар поён туро интизор мешавам."
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "那我一会儿就下去。",
          "pinyin": "Nà wǒ yíhuìr jiù xiàqù.",
          "text": {
            "uz": "Unda men birozdan keyin tushaman.",
            "ru": "Тогда я через минуту спущусь.",
            "tj": "Пас ман каме баъд поён мефароям."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Wang Yixue uyida Bai Jiayue va Annie mehmon bo‘lib kelgan.",
        "ru": "У Ван Исюэ дома Бай Цзяюэ и Энни пришли в гости.",
        "tj": "Дар хонаи Ван Исюэ Бай Ҷяюэ ва Энни ба меҳмонӣ омадаанд."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue & Annie",
          "zh": "你们好！",
          "pinyin": "Nǐmen hǎo!",
          "text": {
            "uz": "Salom!",
            "ru": "Здравствуйте!",
            "tj": "Салом!"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Wang Yixue uyida Bai Jiayue va Annie ovqatlanmoqda.",
        "ru": "У Ван Исюэ дома Бай Цзяюэ и Энни обедают.",
        "tj": "Дар хонаи Ван Исюэ Бай Ҷяюэ ва Энни хӯрок мехӯранд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "都12点了，我们吃饭吧。",
          "pinyin": "Dōu shí'èr diǎn le, wǒmen chī fàn ba.",
          "text": {
            "uz": "Soat allaqachon 12 bo‘ldi, ovqatlanaylik.",
            "ru": "Уже двенадцать, давайте есть.",
            "tj": "Соат аллакай 12 шуд, биёед хӯрок хӯрем."
          }
        }
      ]
    }
