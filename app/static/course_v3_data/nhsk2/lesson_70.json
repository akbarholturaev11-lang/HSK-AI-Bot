            "ru": "Куда собираешься?",
            "tj": "Ба куҷо рафтан мехоҳӣ?"
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "你想做的事情很多啊！",
          "pinyin": "Nǐ xiǎng zuò de shìqing hěn duō a!",
          "text": {
            "uz": "Qilmoqchi bo‘lgan ishlaring juda ko‘p ekan!",
            "ru": "У тебя столько планов!",
            "tj": "Корҳое, ки кардан мехоҳӣ, хеле зиёданд!"
          }
        }
