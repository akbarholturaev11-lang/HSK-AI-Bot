  "dialogues": [
    {
      "scene": {
        "uz": "Xonada Liu Ming Liu Xiaominga narsalarni tayyorlashga yordam bermoqda.",
        "ru": "В комнате Лю Мин помогает Лю Сяомину готовить вещи.",
        "tj": "Дар ҳуҷра Лю Мин ба Лю Сяомин барои тайёр кардани чизҳо кӯмак мекунад."
