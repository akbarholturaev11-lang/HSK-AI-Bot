  "dialogues": [
    {
      "scene": {
        "uz": "Aeroportda Wang Yixue Bai Jiayue va Annieni kutib oldi.",
        "ru": "В аэропорту Ван Исюэ встретила Бай Цзяюэ и Энни.",
        "tj": "Дар фурудгоҳ Ван Исюэ Бай Ҷяюэ ва Энниро пешвоз гирифт."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "是的，你们就是她的学生吧？",
          "pinyin": "Shì de, nǐmen jiù shì tā de xuésheng ba?",
          "text": {
            "uz": "Ha, sizlar aynan uning talabalarisiz, shundaymi?",
            "ru": "Да. Вы как раз её студенты, верно?",
            "tj": "Ҳа, шумо ҳамон донишҷӯёни ӯ ҳастед, дуруст?"
          }
        },
        {
          "speaker": "Bai Jiayue & Annie",
          "zh": "谢谢您。",
          "pinyin": "Xièxie nín.",
          "text": {
            "uz": "Rahmat sizga.",
            "ru": "Спасибо вам.",
            "tj": "Раҳмат ба шумо."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "不客气。",
          "pinyin": "Bú kèqi.",
          "text": {
            "uz": "Arzimaydi.",
            "ru": "Не за что.",
            "tj": "Марҳамат."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Wang Yixuening mashinasida Bai Jiayue, Annie va Wang Yixue suhbatlashmoqda.",
        "ru": "В машине Ван Исюэ Бай Цзяюэ, Энни и Ван Исюэ разговаривают.",
        "tj": "Дар мошини Ван Исюэ Бай Ҷяюэ, Энни ва Ван Исюэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue",
          "zh": "是的，我们都是第一次来。",
          "pinyin": "Shì de, wǒmen dōu shì dì yī cì lái.",
          "text": {
            "uz": "Ha, hammamiz birinchi marta keldik.",
            "ru": "Да, мы обе приехали впервые.",
            "tj": "Ҳа, ҳамаи мо бори аввал омадем."
          }
        },
        {
          "speaker": "Annie",
          "zh": "不是，我们是来旅游的。",
          "pinyin": "Bú shì, wǒmen shì lái lǚyóu de.",
          "text": {
            "uz": "Yo‘q, biz sayohat qilish uchun keldik.",
            "ru": "Нет, мы приехали путешествовать.",
            "tj": "Не, мо барои саёҳат омадем."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "我这几天都不忙，你们有事就找我。",
          "pinyin": "Wǒ zhè jǐ tiān dōu bù máng, nǐmen yǒu shì jiù zhǎo wǒ.",
          "text": {
            "uz": "Shu kunlarda band emasman, ishingiz bo‘lsa meni toping.",
            "ru": "В эти дни я не занята, если что-то понадобится — обращайтесь ко мне.",
            "tj": "Ин чанд рӯз ман банд нестам, агар коре бошад ба ман муроҷиат кунед."
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "好的，谢谢您。",
          "pinyin": "Hǎo de, xièxie nín.",
          "text": {
            "uz": "Xo‘p, rahmat sizga.",
            "ru": "Хорошо, спасибо вам.",
            "tj": "Хуб, раҳмат ба шумо."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Wang Yixuening mashinasida Bai Jiayue telefon qo‘ng‘irog‘iga javob berdi.",
        "ru": "В машине Ван Исюэ Бай Цзяюэ ответила на звонок.",
        "tj": "Дар мошини Ван Исюэ Бай Ҷяюэ ба занги телефон ҷавоб дод."
