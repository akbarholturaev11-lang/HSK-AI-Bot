  "dialogues": [
    {
      "scene": {
        "uz": "Sinfda Annie va Chen Tianzhong suhbatlashmoqda.",
        "ru": "В классе Энни и Чэнь Тяньчжун разговаривают.",
        "tj": "Дар синф Энни ва Чэн Тянҷун суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Chen Tianzhong",
          "zh": "我跟同学说好了，一起去打篮球。",
          "pinyin": "Wǒ gēn tóngxué shuōhǎo le, yìqǐ qù dǎ lánqiú.",
          "text": {
            "uz": "Sinfdoshlar bilan kelishib qo‘ydim, birga basketbol o‘ynagani boramiz.",
            "ru": "Я договорился с одноклассниками вместе поиграть в баскетбол.",
            "tj": "Бо ҳамсинфон маслиҳат кардем, якҷо баскетбол бозӣ мекунем."
          }
        },
        {
          "speaker": "Annie",
          "zh": "我也想跟你们一起玩。",
          "pinyin": "Wǒ yě xiǎng gēn nǐmen yìqǐ wán.",
          "text": {
            "uz": "Men ham sizlar bilan birga o‘ynagim keladi.",
            "ru": "Я тоже хочу поиграть с вами.",
            "tj": "Ман ҳам мехоҳам бо шумо якҷо бозӣ кунам."
          }
        },
        {
          "speaker": "Chen Tianzhong",
          "zh": "没问题，走吧。",
          "pinyin": "Méi wèntí, zǒu ba.",
          "text": {
            "uz": "Muammo yo‘q, yur.",
            "ru": "Без проблем, пошли.",
            "tj": "Мушкил нест, равем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Kampusda Annie va Chen Tianzhong yurib suhbatlashmoqda.",
        "ru": "В кампусе Энни и Чэнь Тяньчжун разговаривают на ходу.",
