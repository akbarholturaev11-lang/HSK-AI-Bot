  "dialogues": [
    {
      "scene": {
        "uz": "Do‘konda Wang Yixue va Liu Ming shimlarni ko‘rmoqda.",
        "ru": "В магазине Ван Исюэ и Лю Мин смотрят брюки.",
        "tj": "Дар мағоза Ван Исюэ ва Лю Мин шим мебинанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "儿子的裤子坏了，我们给他买条新的吧。",
          "pinyin": "Érzi de kùzi huài le, wǒmen gěi tā mǎi tiáo xīn de ba.",
          "text": {
            "uz": "O‘g‘limizning shimi buzilibdi, unga yangisini olaylik.",
            "ru": "Брюки сына испортились, давай купим ему новые.",
            "tj": "Шими писарамон вайрон шудааст, барояш нав бихарем."
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "好啊。",
          "pinyin": "Hǎo a.",
          "text": {
            "uz": "Mayli.",
            "ru": "Хорошо.",
            "tj": "Хуб."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "你看这条黑色的怎么样？",
          "pinyin": "Nǐ kàn zhè tiáo hēisè de zěnmeyàng?",
          "text": {
            "uz": "Bu qora shim qanday?",
            "ru": "Как тебе эти чёрные брюки?",
            "tj": "Ин шими сиёҳ чӣ хел?"
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "没有你上次买的那条好看。",
          "pinyin": "Méiyǒu nǐ shàng cì mǎi de nà tiáo hǎokàn.",
          "text": {
            "uz": "O‘tgan safar olganingchalik chiroyli emas.",
            "ru": "Не такие красивые, как те, что ты купила в прошлый раз.",
            "tj": "Ба зебоии оне, ки дафъаи гузашта харидӣ, намерасад."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "旁边那个男孩儿就穿了这样的裤子，我觉得很好看啊！",
          "pinyin": "Pángbian nàge nánháir jiù chuānle zhèyàng de kùzi, wǒ juéde hěn hǎokàn a!",
          "text": {
            "uz": "Yonimizdagi bola ham shunday shim kiygan, menimcha juda chiroyli!",
            "ru": "Вон мальчик рядом носит такие брюки, по-моему, выглядят отлично!",
            "tj": "Писарбачаи паҳлӯ ҳамин хел шим пӯшидааст, ба назарам хеле зебост!"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "好吧，我们再去那边看看。",
          "pinyin": "Hǎo ba, wǒmen zài qù nàbian kànkan.",
          "text": {
            "uz": "Mayli, yana u tomonga borib ko‘raylik.",
            "ru": "Ладно, давай посмотрим ещё там.",
            "tj": "Хуб, боз он тараф рафта бинем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Do‘kon kirishida Wang Yixue va Liu Ming tashqariga chiqmoqda.",
        "ru": "У входа в магазин Ван Исюэ и Лю Мин выходят наружу.",
        "tj": "Дар назди даромадгоҳи мағоза Ван Исюэ ва Лю Мин ба берун мебароянд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "那你等一下，我去买杯奶茶。",
          "pinyin": "Nà nǐ děng yíxià, wǒ qù mǎi bēi nǎichá.",
          "text": {
            "uz": "Unda biroz kut, men bir piyola sutli choy olib kelaman.",
            "ru": "Тогда подожди, я схожу куплю молочный чай.",
            "tj": "Пас каме интизор шав, ман рафта як пиёла чойи ширӣ мехарам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Qahvaxona oldida Wang Yixue va Liu Ming suhbatlashmoqda.",
        "ru": "У входа в кофейню Ван Исюэ и Лю Мин разговаривают.",
        "tj": "Дар назди қаҳвахона Ван Исюэ ва Лю Мин суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Liu Ming",
          "zh": "我们打车回去吧。",
          "pinyin": "Wǒmen dǎchē huíqù ba.",
          "text": {
            "uz": "Uyga taksida qaytaylik.",
            "ru": "Давай поедем обратно на такси.",
            "tj": "Биё бо таксӣ ба хона баргардем."
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "要走多长时间？",
          "pinyin": "Yào zǒu duō cháng shíjiān?",
          "text": {
            "uz": "Qancha vaqt yurish kerak?",
            "ru": "Сколько времени идти?",
            "tj": "Чанд вақт роҳ рафтан лозим?"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "走半个多小时就到了。",
          "pinyin": "Zǒu bàn ge duō xiǎoshí jiù dào le.",
          "text": {
            "uz": "Yarim soatdan sal ko‘proq yursak yetamiz.",
            "ru": "Чуть больше получаса пешком — и дойдём.",
            "tj": "Каме бештар аз ним соат роҳ равем, мерасем."
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "好的。每天上下班都坐车，今天运动运动吧。",
          "pinyin": "Hǎo de. Měitiān shàngxiàbān dōu zuò chē, jīntiān yùndong yùndong ba.",
          "text": {
            "uz": "Xo‘p. Har kuni ishga borib-kelishda mashinada yuraman, bugun sal harakat qilay.",
            "ru": "Хорошо. Каждый день езжу на работу и обратно, сегодня немного разомнёмся.",
            "tj": "Хуб. Ҳар рӯз ба кору аз кор бо мошин меравам, имрӯз каме машқ кунем."
          }
        }
      ]
    }
  ],
