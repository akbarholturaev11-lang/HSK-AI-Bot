      },
      "dialogue": [
        {
          "speaker": "Wang Yifei",
          "zh": "今天不大，昨天比今天下得大。",
          "pinyin": "Jīntiān bú dà, zuótiān bǐ jīntiān xià de dà.",
          "text": {
            "uz": "Bugun kuchli emas, kecha bugungidan kuchliroq yog‘di.",
            "ru": "Сегодня не сильно, вчера снег шёл сильнее, чем сегодня.",
            "tj": "Имрӯз сахт нест, дирӯз аз имрӯз сахттар борид."
