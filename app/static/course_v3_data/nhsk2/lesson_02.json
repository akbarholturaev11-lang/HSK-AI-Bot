  "dialogues": [
    {
      "scene": {
        "uz": "Aeroportda Wang Yixue Bai Jiayue va Annieni kutib oldi.",
        "ru": "В аэропорту Ван Исюэ встретила Бай Цзяюэ и Энни.",
