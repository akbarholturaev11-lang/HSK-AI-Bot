      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "是的，你们就是她的学生吧？",
          "pinyin": "Shì de, nǐmen jiù shì tā de xuésheng ba?",
          "text": {
            "uz": "Ha, sizlar aynan uning talabalarisiz, shundaymi?",
            "ru": "Да. Вы как раз её студенты, верно?",
            "tj": "Ҳа, шумо ҳамон донишҷӯёни ӯ ҳастед, дуруст?"
