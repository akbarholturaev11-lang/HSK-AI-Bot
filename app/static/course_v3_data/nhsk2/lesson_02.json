        },
        {
          "speaker": "Bai Jiayue & Annie",
          "zh": "谢谢您。",
          "pinyin": "Xièxie nín.",
          "text": {
            "uz": "Rahmat sizga.",
            "ru": "Спасибо вам.",
            "tj": "Раҳмат ба шумо."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "不客气。",
          "pinyin": "Bú kèqi.",
          "text": {
            "uz": "Arzimaydi.",
            "ru": "Не за что.",
            "tj": "Марҳамат."
          }
        }
      ]
    },
