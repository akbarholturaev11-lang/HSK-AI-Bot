      "scene": {
        "uz": "Sinfda Wang Yifei va Bai Jiayue suhbatlashmoqda.",
        "ru": "В классе Ван Ифэй и Бай Цзяюэ разговаривают.",
        "tj": "Дар синф Ван Ифэй ва Бай Ҷяюэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yifei",
          "zh": "家月，都下课了，你怎么还不回家？",
          "pinyin": "Jiāyuè, dōu xiàkè le, nǐ zěnme hái bù huí jiā?",
          "text": {
            "uz": "Jiayue, dars tugadi-ku, nega hali uyga ketmading?",
            "ru": "Цзяюэ, урок уже закончился, почему ты ещё не идёшь домой?",
