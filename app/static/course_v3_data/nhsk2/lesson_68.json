  "dialogues": [
    {
      "scene": {
        "uz": "Uyga qaytish yo‘lida Li Wen va Wang Yifei yurib suhbatlashmoqda.",
        "ru": "По дороге домой Ли Вэнь и Ван Ифэй разговаривают на ходу.",
        "tj": "Дар роҳи бозгашт ба хона Ли Вэн ва Ван Ифэй роҳравон суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yifei",
          "zh": "我家楼下？我看看。",
          "pinyin": "Wǒ jiā lóuxià? Wǒ kànkan.",
          "text": {
            "uz": "Uyim pastidami? Qani ko‘ray.",
            "ru": "Внизу моего дома? Дай посмотрю.",
            "tj": "Поёни хонаи ман? Бинам."
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "那个人穿着黑色的裤子，手里还拿着一个黑色的包。",
          "pinyin": "Nàge rén chuānzhe hēisè de kùzi, shǒulǐ hái názhe yí ge hēisè de bāo.",
          "text": {
            "uz": "U odam qora shim kiygan, qo‘lida yana qora sumka bor.",
            "ru": "На том человеке чёрные брюки, а в руке он держит чёрную сумку.",
            "tj": "Он одам шими сиёҳ пӯшидааст ва дар дасташ халтаи сиёҳ дорад."
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "我看见那个人了，他是我男朋友。",
          "pinyin": "Wǒ kànjiàn nàge rén le, tā shì wǒ nánpéngyou.",
          "text": {
            "uz": "Ko‘rdim, u mening yigitim.",
            "ru": "Я его вижу, это мой молодой человек.",
            "tj": "Ӯро дидам, ӯ дӯстписари ман аст."
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "那我们快过去吧。",
          "pinyin": "Nà wǒmen kuài guòqu ba.",
          "text": {
            "uz": "Unda tezroq u tomonga boraylik.",
            "ru": "Тогда пойдём скорее к нему.",
            "tj": "Пас зуд ба он тараф равем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Bino pastida Wang Yifei Yang Tongle bilan uchrashdi.",
        "ru": "Внизу дома Ван Ифэй встретила Ян Тунлэ.",
        "tj": "Дар поёни бино Ван Ифэй бо Ян Тунлэ вохӯрд."
      },
      "dialogue": [
        {
          "speaker": "Yang Tongle",
          "zh": "就要过年了，你一个人在这儿多没意思啊，所以我就早早过来了。",
          "pinyin": "Jiù yào guònián le, nǐ yí ge rén zài zhèr duō méi yìsi a, suǒyǐ wǒ jiù zǎozǎo guòlai le.",
          "text": {
            "uz": "Yangi yilga oz qoldi, bu yerda yolg‘iz qolish naqadar zerikarli, shuning uchun erta keldim.",
            "ru": "Скоро Новый год, одному здесь так скучно, поэтому я приехал пораньше.",
            "tj": "Ба Соли нав кам мондааст, танҳо будан дар ин ҷо чӣ қадар дилгир аст, барои ҳамин барвақт омадам."
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "你能来，我太高兴了！",
          "pinyin": "Nǐ néng lái, wǒ tài gāoxìng le!",
          "text": {
            "uz": "Kelganingdan juda xursandman!",
