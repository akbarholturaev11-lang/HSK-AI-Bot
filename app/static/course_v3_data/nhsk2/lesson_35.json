      "dialogue": [
        {
          "speaker": "Chen Tianzhong",
          "zh": "你篮球打得怎么样？",
          "pinyin": "Nǐ lánqiú dǎ de zěnmeyàng?",
          "text": {
            "uz": "Basketbolni qanday o‘ynaysan?",
