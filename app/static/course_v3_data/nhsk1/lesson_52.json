  "dialogues": [
    {
      "scene": {
        "uz": "Wang Yifeining uyida Bai Jiayue va Chen Tianzhong mehmonga kelgan.",
        "ru": "Бай Цзяюэ и Чэнь Тяньчжун пришли в гости к Ван Ифэй.",
        "tj": "Бай Ҷяюэ ва Чэн Тянҷун ба хонаи Ван Ифэй меҳмон шудаанд."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue",
          "zh": "房间外有一只小猫。",
          "pinyin": "Fángjiān wài yǒu yì zhī xiǎomāo.",
          "text": {
            "uz": "Xona tashqarisida bitta kichik mushuk bor.",
            "ru": "Снаружи комнаты есть маленький котёнок.",
            "tj": "Берун аз ҳуҷра як гурбачаи хурд ҳаст."
          }
        },
        {
          "speaker": "Chen Tianzhong",
          "zh": "我没看见，它在哪儿呢？",
          "pinyin": "Wǒ méi kànjiàn, tā zài nǎr ne?",
          "text": {
            "uz": "Men uni ko‘rmadim, u qayerda?",
            "ru": "Я его не вижу. Где он?",
            "tj": "Ман онро надидам, он куҷост?"
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "它在桌子下呢。",
          "pinyin": "Tā zài zhuōzi xià ne.",
          "text": {
            "uz": "U stol ostida.",
            "ru": "Он под столом.",
            "tj": "Он зери миз аст."
          }
        },
        {
          "speaker": "Chen Tianzhong",
          "zh": "这只小猫真漂亮！",
          "pinyin": "Zhè zhī xiǎomāo zhēn piàoliang!",
          "text": {
            "uz": "Bu kichik mushuk juda chiroyli!",
            "ru": "Этот котёнок очень красивый!",
            "tj": "Ин гурбачаи хурд хеле зебост!"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Darsdan keyin sinfda Bai Jiayue Li Wenga telefon qilmoqda.",
        "ru": "После занятия Бай Цзяюэ звонит Ли Вэню из аудитории.",
        "tj": "Пас аз дарс Бай Ҷяюэ аз синф ба Ли Вэн занг мезанад."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue",
          "zh": "我们在哪儿见呢？",
          "pinyin": "Wǒmen zài nǎr jiàn ne?",
          "text": {
            "uz": "Qayerda uchrashamiz?",
            "ru": "Где мы встретимся?",
            "tj": "Дар куҷо вомехӯрем?"
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "好的。下午两点你能到吗？",
          "pinyin": "Hǎo de. Xiàwǔ liǎng diǎn nǐ néng dào ma?",
          "text": {
            "uz": "Xo‘p. Tushdan keyin soat 2 da yetib kela olasanmi?",
            "ru": "Хорошо. Ты сможешь прийти в 2 часа дня?",
            "tj": "Хуб. Баъди нисфирӯзӣ соати 2 расида метавонӣ?"
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "我能到。我在学校吃午饭。",
          "pinyin": "Wǒ néng dào. Wǒ zài xuéxiào chī wǔfàn.",
          "text": {
            "uz": "Yetib kela olaman. Men maktabda tushlik qilaman.",
            "ru": "Да, смогу. Я пообедаю в школе.",
            "tj": "Расида метавонам. Ман дар мактаб хӯроки нисфирӯзӣ мехӯрам."
          }
        }
      ]
    },
    {
      "scene": {
