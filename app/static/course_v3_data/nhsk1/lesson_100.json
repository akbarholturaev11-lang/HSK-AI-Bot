  "dialogues": [
    {
      "scene": {
        "uz": "Li Wenning uyida u Chen Tianzhong, Bai Jiayue va boshqa do‘stlarini xitoy taomlarini tatib ko‘rishga taklif qilgan.",
        "ru": "Дома у Ли Вэня он угощает китайской едой Чэнь Тяньчжуна, Бай Цзяюэ и других друзей.",
        "tj": "Дар хонаи Ли Вэн ӯ Чэн Тянҷун, Бай Ҷяюэ ва дигар дӯстонашро бо таоми чинӣ меҳмондорӣ мекунад."
      },
      "dialogue": [
        {
          "speaker": "Li Wen",
          "zh": "你们爱吃哪个菜？",
          "pinyin": "Nǐmen ài chī nǎge cài?",
          "text": {
            "uz": "Qaysi taomni yoqtirasizlar?",
            "ru": "Какое блюдо вам нравится?",
            "tj": "Кадом таомро дӯст медоред?"
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "我喜欢这个，也喜欢那个。",
          "pinyin": "Wǒ xǐhuan zhège, yě xǐhuan nàge.",
          "text": {
            "uz": "Buni yoqtiraman, anavini ham yoqtiraman.",
            "ru": "Мне нравится это, и то тоже нравится.",
            "tj": "Инро дӯст медорам, онро ҳам дӯст медорам."
          }
        },
        {
          "speaker": "Chen Tianzhong",
          "zh": "这些菜都好吃，还很好看。",
          "pinyin": "Zhèxiē cài dōu hǎochī, hái hěn hǎokàn.",
          "text": {
            "uz": "Bu taomlarning hammasi mazali, ko‘rinishi ham juda chiroyli.",
            "ru": "Все эти блюда вкусные и ещё очень красиво выглядят.",
            "tj": "Ҳамаи ин таомҳо болаззатанд ва хеле зебо ҳам менамоянд."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Li Wenning uyida hamma ovqatlanib turib ta’til rejalarini muhokama qilmoqda.",
        "ru": "Дома у Ли Вэня все за едой обсуждают планы на каникулы.",
        "tj": "Дар хонаи Ли Вэн ҳама ҳангоми хӯрок нақшаҳои таътилро муҳокима мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Li Wen",
          "zh": "你们都想去哪儿？",
          "pinyin": "Nǐmen dōu xiǎng qù nǎr?",
          "text": {
            "uz": "Hammangiz qayerga bormoqchisiz?",
            "ru": "Куда вы все хотите поехать?",
            "tj": "Ҳамаатон ба куҷо рафтан мехоҳед?"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Sinf tashqarisida Bai Jiayue, Annie va ustoz Wang Pekinga sayohat haqida gaplashmoqda.",
        "ru": "У аудитории Бай Цзяюэ, Энни и преподаватель Ван обсуждают поездку в Пекин.",
