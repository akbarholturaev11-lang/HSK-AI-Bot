  "dialogues": [
    {
      "scene": {
        "uz": "Wang Yixue Wang Yifeiga telefon qilib, u tomondagi vaziyatni so‘ramoqda.",
        "ru": "Ван Исюэ звонит Ван Ифэй и спрашивает, как там обстановка.",
        "tj": "Ван Исюэ ба Ван Ифэй занг зада, вазъияти он ҷоро мепурсад."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "今天天气怎么样？",
          "pinyin": "Jīntiān tiānqì zěnmeyàng?",
          "text": {
            "uz": "Bugun ob-havo qanday?",
            "ru": "Какая сегодня погода?",
            "tj": "Имрӯз обу ҳаво чӣ хел?"
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "这里的天不太好，下雨了。",
          "pinyin": "Zhèlǐ de tiān bú tài hǎo, xià yǔ le.",
          "text": {
            "uz": "Bu yerda ob-havo unchalik yaxshi emas, yomg‘ir yog‘yapti.",
            "ru": "Здесь погода не очень, идёт дождь.",
            "tj": "Ин ҷо ҳаво он қадар хуб нест, борон меборад."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "雨大吗？",
          "pinyin": "Yǔ dà ma?",
          "text": {
            "uz": "Yomg‘ir kuchlimi?",
            "ru": "Дождь сильный?",
            "tj": "Борон сахт аст?"
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "有点儿大，我觉得很冷。",
          "pinyin": "Yǒudiǎnr dà, wǒ juéde hěn lěng.",
          "text": {
            "uz": "Biroz kuchli, men juda sovqotyapman.",
            "ru": "Немного сильный, и мне очень холодно.",
            "tj": "Каме сахт аст, ман хеле сард ҳис мекунам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Kompaniya liftida Wang Yixue va Yang Tongle suhbatlashmoqda.",
        "ru": "В лифте компании Ван Исюэ и Ян Тунлэ разговаривают.",
        "tj": "Дар лифти ширкат Ван Исюэ ва Ян Тунлэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "昨天下雪了。",
          "pinyin": "Zuótiān xià xuě le.",
          "text": {
            "uz": "Kecha qor yog‘di.",
