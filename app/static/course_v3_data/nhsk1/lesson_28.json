  "dialogues": [
    {
      "scene": {
        "uz": "Uyda Liu Ming va Wang Yixue suhbatlashmoqda.",
        "ru": "Дома Лю Мин и Ван Исюэ разговаривают.",
        "tj": "Дар хона Лю Мин ва Ван Исюэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "今天几号？",
          "pinyin": "Jīntiān jǐ hào?",
          "text": {
            "uz": "Bugun nechanchi sana?",
            "ru": "Какое сегодня число?",
            "tj": "Имрӯз чандум аст?"
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "今天9月8号。",
          "pinyin": "Jīntiān jiǔ yuè bā hào.",
          "text": {
            "uz": "Bugun 8-sentabr.",
            "ru": "Сегодня 8 сентября.",
            "tj": "Имрӯз 8 сентябр аст."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "星期几？",
          "pinyin": "Xīngqī jǐ?",
          "text": {
            "uz": "Bugun haftaning qaysi kuni?",
            "ru": "Какой сегодня день недели?",
            "tj": "Имрӯз кадом рӯзи ҳафта аст?"
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "星期日。今天我休息。",
          "pinyin": "Xīngqīrì. Jīntiān wǒ xiūxi.",
          "text": {
            "uz": "Yakshanba. Bugun men dam olaman.",
            "ru": "Воскресенье. Сегодня я отдыхаю.",
            "tj": "Якшанбе. Имрӯз ман истироҳат мекунам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Kompaniyada Wang Yixue va Yang Tongle tanaffusda suhbatlashmoqda.",
        "ru": "В компании Ван Исюэ и Ян Тунлэ разговаривают во время перерыва.",
        "tj": "Дар ширкат Ван Исюэ ва Ян Тунлэ ҳангоми танаффус суҳбат мекунанд."
