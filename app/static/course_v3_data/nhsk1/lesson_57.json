  "dialogues": [
    {
      "scene": {
        "uz": "Kampusda Li Wen va Bai Jiayue suhbatlashmoqda.",
        "ru": "В кампусе Ли Вэнь и Бай Цзяюэ разговаривают.",
        "tj": "Дар кампус Ли Вэн ва Бай Ҷяюэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Li Wen",
          "zh": "学校前边有一家电影院。",
          "pinyin": "Xuéxiào qiánbian yǒu yì jiā diànyǐngyuàn.",
          "text": {
            "uz": "Maktab oldida bitta kinoteatr bor.",
            "ru": "Перед школой есть кинотеатр.",
            "tj": "Пеши мактаб як кинотеатр ҳаст."
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "对。我们晚上去那个电影院看电影吧。",
          "pinyin": "Duì. Wǒmen wǎnshang qù nàge diànyǐngyuàn kàn diànyǐng ba.",
          "text": {
            "uz": "Ha. Bugun kechqurun o‘sha kinoteatrga film ko‘rgani boraylik.",
            "ru": "Да. Давай вечером пойдём в тот кинотеатр посмотреть фильм.",
            "tj": "Ҳа. Биёед шом ба ҳамон кинотеатр барои тамошои филм равем."
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "好！我们七点在电影院外边见，好吗？",
          "pinyin": "Hǎo! Wǒmen qī diǎn zài diànyǐngyuàn wàibian jiàn, hǎo ma?",
          "text": {
            "uz": "Yaxshi! Soat 7 da kinoteatr tashqarisida uchrashamiz, maylimi?",
            "ru": "Хорошо! Встретимся в 7 часов у кинотеатра, ладно?",
            "tj": "Хуб! Соати 7 беруни кинотеатр вомехӯрем, майлаш?"
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "好的，晚上七点见！",
          "pinyin": "Hǎo de, wǎnshang qī diǎn jiàn!",
          "text": {
            "uz": "Xo‘p, kechqurun soat 7 da ko‘rishamiz!",
            "ru": "Хорошо, увидимся в 7 вечера!",
            "tj": "Хуб, шом соати 7 мебинем!"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Darsdan keyin sinfda Bai Jiayue va Chen Tianzhong suhbatlashmoqda.",
        "ru": "После занятия Бай Цзяюэ и Чэнь Тяньчжун разговаривают в аудитории.",
        "tj": "Пас аз дарс Бай Ҷяюэ ва Чэн Тянҷун дар синф суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue",
          "zh": "不客气。你明天上午在哪儿？",
          "pinyin": "Bú kèqi. Nǐ míngtiān shàngwǔ zài nǎr?",
          "text": {
            "uz": "Arzimaydi. Ertaga ertalab qayerda bo‘lasan?",
            "ru": "Не за что. Где ты будешь завтра утром?",
            "tj": "Марҳамат. Фардо субҳ дар куҷо мешавӣ?"
          }
        },
        {
          "speaker": "Chen Tianzhong",
          "zh": "我明天上午在学校学习。",
          "pinyin": "Wǒ míngtiān shàngwǔ zài xuéxiào xuéxí.",
          "text": {
            "uz": "Men ertaga ertalab maktabda o‘qiyman.",
            "ru": "Завтра утром я буду заниматься в школе.",
            "tj": "Ман фардо субҳ дар мактаб таҳсил мекунам."
          }
        }
      ]
    },
    {
      "scene": {
