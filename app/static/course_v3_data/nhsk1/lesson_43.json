      "dialogue": [
        {
          "speaker": "Li Wen",
          "zh": "下午我想去电影院看电影，你去吗？",
          "pinyin": "Xiàwǔ wǒ xiǎng qù diànyǐngyuàn kàn diànyǐng, nǐ qù ma?",
          "text": {
            "uz": "Bugun tushdan keyin kinoteatrga film ko‘rgani bormoqchiman. Sen ham borasanmi?",
            "ru": "Сегодня днём я хочу пойти в кино. Ты пойдёшь?",
            "tj": "Имрӯз баъди нисфирӯзӣ мехоҳам ба кино равам. Ту ҳам меравӣ?"
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "我不想去，下午还有事。",
          "pinyin": "Wǒ bù xiǎng qù, xiàwǔ hái yǒu shì.",
          "text": {
            "uz": "Borgim kelmaydi, tushdan keyin yana ishim bor.",
            "ru": "Я не хочу идти, днём у меня ещё есть дела.",
            "tj": "Рафтан намехоҳам, баъди нисфирӯзӣ боз кор дорам."
