    {
      "scene": {
        "uz": "Bai Jiayue va Annie telefonda gaplashmoqda.",
        "ru": "Бай Цзяюэ и Энни разговаривают по телефону.",
        "tj": "Бай Ҷяюэ ва Энни бо телефон суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue",
          "zh": "现在几点？",
          "pinyin": "Xiànzài jǐ diǎn?",
          "text": {
            "uz": "Hozir soat necha?",
            "ru": "Который сейчас час?",
            "tj": "Ҳозир соат чанд?"
          }
        },
        {
          "speaker": "Annie",
          "zh": "早上八点四十分。",
          "pinyin": "Zǎoshang bā diǎn sìshí fēn.",
          "text": {
            "uz": "Ertalab soat 8:40.",
            "ru": "Сейчас 8:40 утра.",
            "tj": "Субҳ соати 8:40."
          }
        },
        {
          "speaker": "Bai Jiayue",
          "zh": "我上午十点十分有课。",
          "pinyin": "Wǒ shàngwǔ shí diǎn shí fēn yǒu kè.",
          "text": {
            "uz": "Ertalab soat 10:10 da darsim bor.",
            "ru": "У меня занятие в 10:10 утра.",
            "tj": "Субҳ соати 10:10 дарс дорам."
          }
        },
        {
          "speaker": "Annie",
          "zh": "好的，我们下午两点见吧。",
          "pinyin": "Hǎo de, wǒmen xiàwǔ liǎng diǎn jiàn ba.",
          "text": {
            "uz": "Xo‘p, tushdan keyin soat 2 da uchrashamiz.",
            "ru": "Хорошо, давай встретимся в 2 часа дня.",
            "tj": "Хуб, баъди нисфирӯзӣ соати 2 вомехӯрем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Kampusda Li Wen Bai Jiayuega duch keladi.",
        "ru": "В кампусе Ли Вэнь встречает Бай Цзяюэ.",
        "tj": "Дар кампус Ли Вэн бо Бай Ҷяюэ вомехӯрад."
