      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "她很忙。",
          "pinyin": "Tā hěn máng.",
          "text": {
            "uz": "U juda band.",
            "ru": "Она очень занята.",
            "tj": "Ӯ хеле банд аст."
