  "dialogues": [
    {
      "scene": {
        "uz": "Yo‘lda Li Wen restoran qidirayotganida Wang Yifei unga telefon qiladi.",
        "ru": "По дороге, пока Ли Вэнь искал ресторан, Ван Ифэй позвонила ему.",
        "tj": "Дар роҳ, вақте Ли Вэн тарабхонаро меҷуст, Ван Ифэй ба ӯ занг зад."
      },
      "dialogue": [
        {
          "speaker": "Li Wen",
          "zh": "还不知道，正在找呢。它是不是在超市后边？",
          "pinyin": "Hái bù zhīdào, zhèngzài zhǎo ne. Tā shì bu shì zài chāoshì hòubian?",
          "text": {
            "uz": "Hali bilmayman, hozir qidiryapman. U supermarket orqasidami?",
            "ru": "Пока не знаю, сейчас ищу. Он за супермаркетом?",
            "tj": "Ҳоло намедонам, ҷустуҷӯ карда истодаам. Он паси супермаркет аст?"
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "是的。你开车没开车？",
          "pinyin": "Shì de. Nǐ kāichē méi kāichē?",
          "text": {
            "uz": "Ha. Mashina haydayapsanmi yo‘qmi?",
            "ru": "Да. Ты за рулём или нет?",
            "tj": "Ҳа. Мошин меронӣ ё не?"
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "我没开车，坐车呢。",
          "pinyin": "Wǒ méi kāichē, zuò chē ne.",
          "text": {
            "uz": "Mashina haydamayapman, transportda ketyapman.",
            "ru": "Нет, я не за рулём, еду на машине.",
            "tj": "Не, мошин намеронам, бо нақлиёт меравам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Restoranda uchrashgach Wang Yifei va Li Wen suhbatlashmoqda.",
        "ru": "После встречи в ресторане Ван Ифэй и Ли Вэнь разговаривают.",
        "tj": "Пас аз вохӯрӣ дар тарабхона Ван Ифэй ва Ли Вэн суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yifei",
          "zh": "你们学习忙不忙？",
