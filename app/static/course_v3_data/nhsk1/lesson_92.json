    {
      "scene": {
        "uz": "Darsda Wang Yifei talabalarining o‘qish holatini so‘ramoqda.",
        "ru": "На занятии Ван Ифэй спрашивает студентов об их успехах в учёбе.",
        "tj": "Дар дарс Ван Ифэй аз донишҷӯён дар бораи пешрафти таҳсил мепурсад."
      },
      "dialogue": [
        {
          "speaker": "Bai Jiayue",
          "zh": "我们都会写了。",
          "pinyin": "Wǒmen dōu huì xiě le.",
          "text": {
            "uz": "Hammamiz yoza olamiz.",
            "ru": "Мы все уже умеем писать.",
            "tj": "Ҳамаамон навишта метавонем."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Uyda Liu Ming va Wang Yixue bolalarining keyingi maktabga o‘tishi haqida gaplashmoqda.",
        "ru": "Дома Лю Мин и Ван Исюэ обсуждают поступление детей в следующую школу.",
        "tj": "Дар хона Лю Мин ва Ван Исюэ дар бораи гузаштани фарзандон ба мактаби нав суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "对。儿子也上小学了。",
          "pinyin": "Duì. Érzi yě shàng xiǎoxué le.",
          "text": {
            "uz": "Ha. O‘g‘limiz ham boshlang‘ich maktabga boradi.",
            "ru": "Да. Сын тоже пойдёт в начальную школу.",
            "tj": "Ҳа. Писарамон ҳам ба мактаби ибтидоӣ меравад."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "还有了一个小学生。",
          "pinyin": "Hái yǒule yí ge xiǎoxuéshēng.",
          "text": {
            "uz": "Yana bitta boshlang‘ich maktab o‘quvchisi ham bo‘ladi.",
            "ru": "И ещё ученик начальной школы.",
            "tj": "Боз як хонандаи мактаби ибтидоӣ ҳам мешавад."
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "上学后，他们都忙了。",
          "pinyin": "Shàngxué hòu, tāmen dōu máng le.",
          "text": {
            "uz": "Maktab boshlangach, ikkalasi ham band bo‘ladi.",
            "ru": "Когда начнётся школа, оба будут заняты.",
            "tj": "Баъди мактаб сар кардан, ҳар ду банд мешаванд."
          }
        }
      ]
    }
