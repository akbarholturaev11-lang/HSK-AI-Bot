  "dialogues": [
    {
      "scene": {
        "uz": "Yo‘lda Li Wen restoran qidirayotganida Wang Yifei unga telefon qiladi.",
        "ru": "По дороге, пока Ли Вэнь искал ресторан, Ван Ифэй позвонила ему.",
        "tj": "Дар роҳ, вақте Ли Вэн тарабхонаро меҷуст, Ван Ифэй ба ӯ занг зад."
      },
      "dialogue": [
        {
          "speaker": "Li Wen",
          "zh": "还不知道，正在找呢。它是不是在超市后边？",
          "pinyin": "Hái bù zhīdào, zhèngzài zhǎo ne. Tā shì bu shì zài chāoshì hòubian?",
          "text": {
            "uz": "Hali bilmayman, hozir qidiryapman. U supermarket orqasidami?",
            "ru": "Пока не знаю, сейчас ищу. Он за супермаркетом?",
            "tj": "Ҳоло намедонам, ҷустуҷӯ карда истодаам. Он паси супермаркет аст?"
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "是的。你开车没开车？",
          "pinyin": "Shì de. Nǐ kāichē méi kāichē?",
          "text": {
            "uz": "Ha. Mashina haydayapsanmi yo‘qmi?",
            "ru": "Да. Ты за рулём или нет?",
            "tj": "Ҳа. Мошин меронӣ ё не?"
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "我没开车，坐车呢。",
          "pinyin": "Wǒ méi kāichē, zuò chē ne.",
          "text": {
            "uz": "Mashina haydamayapman, transportda ketyapman.",
            "ru": "Нет, я не за рулём, еду на машине.",
            "tj": "Не, мошин намеронам, бо нақлиёт меравам."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Restoranda uchrashgach Wang Yifei va Li Wen suhbatlashmoqda.",
        "ru": "После встречи в ресторане Ван Ифэй и Ли Вэнь разговаривают.",
        "tj": "Пас аз вохӯрӣ дар тарабхона Ван Ифэй ва Ли Вэн суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yifei",
          "zh": "你还在读大学吗？",
          "pinyin": "Nǐ hái zài dú dàxué ma?",
          "text": {
            "uz": "Hali ham universitetda o‘qiyapsanmi?",
            "ru": "Ты всё ещё учишься в университете?",
            "tj": "Ҳоло ҳам дар донишгоҳ мехонӣ?"
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "对，我读大学呢，还是大学生。",
          "pinyin": "Duì, wǒ dú dàxué ne, hái shì dàxuéshēng.",
          "text": {
            "uz": "Ha, universitetda o‘qiyman, hali talabaman.",
            "ru": "Да, я учусь в университете, я ещё студент.",
            "tj": "Ҳа, дар донишгоҳ мехонам, ҳоло ҳам донишҷӯ ҳастам."
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "你们学习忙不忙？",
          "pinyin": "Nǐmen xuéxí máng bu máng?",
          "text": {
            "uz": "O‘qishingiz bandmi yo‘qmi?",
            "ru": "У вас учёба напряжённая?",
            "tj": "Таҳсилатон сермашғул аст ё не?"
          }
        },
        {
          "speaker": "Li Wen",
          "zh": "非常忙，我学医，我们的课很多。",
          "pinyin": "Fēicháng máng, wǒ xué yī, wǒmen de kè hěn duō.",
          "text": {
            "uz": "Juda band. Men tibbiyot o‘qiyman, darslarimiz juda ko‘p.",
            "ru": "Очень заняты. Я изучаю медицину, у нас много занятий.",
            "tj": "Хеле банд. Ман тиб мехонам, дарсҳоямон бисёранд."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Shanba ertalab Liu Ming kasalxonaga qo‘shimcha ishga ketishidan oldin qizi Xiaoxue bilan gaplashadi.",
        "ru": "В субботу утром Лю Мин собирается на сверхурочную работу в больницу и перед выходом разговаривает с дочерью Сяосюэ.",
        "tj": "Субҳи шанбе Лю Мин барои кори иловагӣ ба беморхона меравад ва пеш аз баромадан бо духтараш Сяосюэ суҳбат мекунад."
      },
      "dialogue": [
        {
          "speaker": "Liu Ming",
          "zh": "弟弟起床没起床呢？",
          "pinyin": "Dìdi qǐchuáng méi qǐchuáng ne?",
