  "dialogues": [
    {
      "scene": {
        "uz": "Uyda Liu Ming va Wang Yixue suhbatlashmoqda.",
        "ru": "Дома Лю Мин и Ван Исюэ разговаривают.",
        "tj": "Дар хона Лю Мин ва Ван Исюэ суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "她很忙。",
          "pinyin": "Tā hěn máng.",
          "text": {
            "uz": "U juda band.",
            "ru": "Она очень занята.",
            "tj": "Ӯ хеле банд аст."
          }
        },
        {
          "speaker": "Liu Ming",
          "zh": "她有多少个学生？",
          "pinyin": "Tā yǒu duōshao ge xuésheng?",
          "text": {
            "uz": "Uning nechta talabasi bor?",
            "ru": "Сколько у неё студентов?",
            "tj": "Ӯ чанд донишҷӯ дорад?"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Kompaniyada Wang Yixue va Yang Tongle tanaffus payti suhbatlashmoqda.",
        "ru": "В компании Ван Исюэ и Ян Тунлэ разговаривают во время перерыва.",
        "tj": "Дар ширкат Ван Исюэ ва Ян Тунлэ ҳангоми танаффус суҳбат мекунанд."
      },
      "dialogue": [
        {
          "speaker": "Wang Yixue",
          "zh": "我有两个哥哥，你呢？",
          "pinyin": "Wǒ yǒu liǎng ge gēge, nǐ ne?",
          "text": {
            "uz": "Mening ikkita akam bor, sen-chi?",
            "ru": "У меня два старших брата. А у тебя?",
            "tj": "Ман ду бародари калон дорам, ту чӣ?"
          }
        },
        {
          "speaker": "Yang Tongle",
          "zh": "我没有哥哥。",
          "pinyin": "Wǒ méiyǒu gēge.",
          "text": {
            "uz": "Mening akam yo‘q.",
            "ru": "У меня нет старшего брата.",
            "tj": "Ман бародари калон надорам."
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "你家有几口人？",
          "pinyin": "Nǐ jiā yǒu jǐ kǒu rén?",
          "text": {
            "uz": "Oilangda nechta odam bor?",
            "ru": "Сколько человек в твоей семье?",
            "tj": "Дар оилаи ту чанд нафар ҳаст?"
          }
        },
        {
          "speaker": "Yang Tongle",
          "zh": "我家有四口人，爸爸、妈妈、妹妹和我。",
          "pinyin": "Wǒ jiā yǒu sì kǒu rén, bàba, māma, mèimei hé wǒ.",
          "text": {
            "uz": "Oilamda to‘rt kishi bor: dadam, onam, singlim va men.",
            "ru": "В моей семье четыре человека: папа, мама, младшая сестра и я.",
            "tj": "Дар оилаи ман чор нафар ҳаст: падар, модар, хоҳари хурдӣ ва ман."
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Ko‘chada Wang Yixue o‘g‘li bilan ketayotib Yang Tonglega duch keladi.",
        "ru": "На улице Ван Исюэ встречает Ян Тунлэ, гуляя с сыном.",
        "tj": "Дар кӯча Ван Исюэ бо писараш рафта истода, бо Ян Тунлэ вомехӯрад."
      },
      "dialogue": [
        {
          "speaker": "Yang Tongle",
          "zh": "这是您儿子吗？",
          "pinyin": "Zhè shì nín érzi ma?",
          "text": {
            "uz": "Bu sizning o‘g‘lingizmi?",
            "ru": "Это ваш сын?",
            "tj": "Ин писари шумост?"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "是的。我有两个孩子，一个女儿，一个儿子。",
          "pinyin": "Shì de. Wǒ yǒu liǎng ge háizi, yí ge nǚ'ér, yí ge érzi.",
          "text": {
            "uz": "Ha. Mening ikki farzandim bor: bir qiz va bir o‘g‘il.",
            "ru": "Да. У меня двое детей: дочь и сын.",
            "tj": "Ҳа. Ман ду фарзанд дорам: як духтар ва як писар."
          }
        },
        {
          "speaker": "Yang Tongle",
          "zh": "您儿子几岁？",
          "pinyin": "Nín érzi jǐ suì?",
          "text": {
            "uz": "O‘g‘lingiz necha yoshda?",
            "ru": "Сколько лет вашему сыну?",
            "tj": "Писари шумо чандсола аст?"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "他今年五岁。",
          "pinyin": "Tā jīnnián wǔ suì.",
          "text": {
            "uz": "U bu yil besh yoshda.",
            "ru": "Ему в этом году пять лет.",
            "tj": "Ӯ имсол панҷсола аст."
          }
        },
        {
          "speaker": "Yang Tongle",
          "zh": "您女儿多大？",
          "pinyin": "Nín nǚ'ér duō dà?",
          "text": {
            "uz": "Qizingiz necha yoshda?",
            "ru": "Сколько лет вашей дочери?",
            "tj": "Духтари шумо чандсола аст?"
          }
        }
      ]
    }
  ],
