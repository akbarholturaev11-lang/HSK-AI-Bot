  "dialogues": [
    {
      "scene": {
        "uz": "Darsdan keyin sinfda Annie Chen Tianzhong telefonidagi suratlarni ko‘rmoqda.",
        "ru": "После занятия в аудитории Энни смотрит фотографии в телефоне Чэнь Тяньчжуна.",
        "tj": "Пас аз дарс дар синф Энни аксҳои телефони Чэн Тянҷунро тамошо мекунад."
      },
      "dialogue": [
        {
          "speaker": "Annie",
          "zh": "这是谁？",
          "pinyin": "Zhè shì shéi?",
          "text": {
            "uz": "Bu kim?",
            "ru": "Кто это?",
            "tj": "Ин кӣ аст?"
          }
        },
        {
          "speaker": "Chen Tianzhong",
          "zh": "这是我女朋友。",
          "pinyin": "Zhè shì wǒ nǚpéngyou.",
          "text": {
            "uz": "Bu mening qiz do‘stim.",
            "ru": "Это моя девушка.",
            "tj": "Ин дӯстдухтари ман аст."
          }
        },
        {
          "speaker": "Annie",
          "zh": "你女朋友是哪国人？",
          "pinyin": "Nǐ nǚpéngyou shì nǎ guó rén?",
          "text": {
            "uz": "Qiz do‘sting qaysi davlatdan?",
            "ru": "Какой национальности твоя девушка?",
            "tj": "Дӯстдухтари ту аз кадом кишвар аст?"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Uyda Wang Yixue opasi Wang Yifei bilan videoqo‘ng‘iroq qilmoqda.",
        "ru": "Дома Ван Исюэ разговаривает по видеосвязи со старшей сестрой Ван Ифэй.",
        "tj": "Дар хона Ван Исюэ бо хоҳари калониаш Ван Ифэй видеозанг мекунад."
      },
      "dialogue": [
        {
          "speaker": "Wang Yifei",
          "zh": "姐姐！",
          "pinyin": "Jiějie!",
          "text": {
            "uz": "Opa!",
            "ru": "Сестра!",
            "tj": "Апа!"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "你工作还忙吗？",
          "pinyin": "Nǐ gōngzuò hái máng ma?",
          "text": {
            "uz": "Ishing hali ham bandmi?",
            "ru": "Ты всё ещё очень занята на работе?",
            "tj": "Корат ҳоло ҳам сермашғул аст?"
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "对，还很忙。你也很忙吗？",
          "pinyin": "Duì, hái hěn máng. Nǐ yě hěn máng ma?",
          "text": {
            "uz": "Ha, hali ham juda bandman. Sen ham bandmisan?",
            "ru": "Да, я всё ещё очень занята. А ты тоже занята?",
            "tj": "Ҳа, ҳоло ҳам хеле банд ҳастам. Ту ҳам бандӣ?"
          }
        },
        {
          "speaker": "Wang Yixue",
          "zh": "我不太忙。我们很想你。",
          "pinyin": "Wǒ bú tài máng. Wǒmen hěn xiǎng nǐ.",
          "text": {
            "uz": "Men unchalik band emasman. Biz seni juda sog‘indik.",
            "ru": "Я не очень занята. Мы очень скучаем по тебе.",
            "tj": "Ман он қадар банд нестам. Мо туро хеле пазмон шудем."
          }
        },
        {
          "speaker": "Wang Yifei",
          "zh": "我也想你们。",
          "pinyin": "Wǒ yě xiǎng nǐmen.",
          "text": {
            "uz": "Men ham sizlarni sog‘indim.",
            "ru": "Я тоже по вам скучаю.",
            "tj": "Ман ҳам шуморо пазмон шудам."
          }
        }
      ]
    }
  ],
