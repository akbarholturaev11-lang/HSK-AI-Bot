  "dialogues": [
    {
      "scene": {
        "uz": "Darsdan keyin sinfda Annie Chen Tianzhong telefonidagi suratlarni ko‘rmoqda.",
        "ru": "После занятия в аудитории Энни смотрит фотографии в телефоне Чэнь Тяньчжуна.",
        "tj": "Пас аз дарс дар синф Энни аксҳои телефони Чэн Тянҷунро тамошо мекунад."
      },
      "dialogue": [
        {
          "speaker": "Annie",
          "zh": "这是谁？",
          "pinyin": "Zhè shì shéi?",
          "text": {
            "uz": "Bu kim?",
            "ru": "Кто это?",
            "tj": "Ин кӣ аст?"
          }
        },
        {
          "speaker": "Chen Tianzhong",
          "zh": "这是我女朋友。",
          "pinyin": "Zhè shì wǒ nǚpéngyou.",
          "text": {
            "uz": "Bu mening qiz do‘stim.",
            "ru": "Это моя девушка.",
            "tj": "Ин дӯстдухтари ман аст."
          }
        },
        {
          "speaker": "Annie",
          "zh": "你女朋友是哪国人？",
          "pinyin": "Nǐ nǚpéngyou shì nǎ guó rén?",
          "text": {
            "uz": "Qiz do‘sting qaysi davlatdan?",
            "ru": "Какой национальности твоя девушка?",
            "tj": "Дӯстдухтари ту аз кадом кишвар аст?"
          }
        }
      ]
    },
    {
      "scene": {
        "uz": "Uyda Wang Yixue opasi Wang Yifei bilan videoqo‘ng‘iroq qilmoqda.",
        "ru": "Дома Ван Исюэ разговаривает по видеосвязи со старшей сестрой Ван Ифэй.",
        "tj": "Дар хона Ван Исюэ бо хоҳари калониаш Ван Ифэй видеозанг мекунад."
      },
      "dialogue": [
        {
          "speaker": "Wang Yifei",
          "zh": "姐姐！",
          "pinyin": "Jiějie!",
          "text": {
            "uz": "Opa!",
            "ru": "Сестра!",
            "tj": "Апа!"
          }
        }
      ]
    }
