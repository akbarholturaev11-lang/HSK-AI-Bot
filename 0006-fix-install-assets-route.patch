From a58f8e310a40b8cbd8741dc3a4d55a60093b805d Mon Sep 17 00:00:00 2001
From: Akbar Holturaev <akbarholturaev11@icloud.com>
Date: Sun, 9 Aug 2026 14:52:43 +0500
Subject: [PATCH 2/2] fix(download): serve the install screenshots and bust the
 guide cache

/assets is not a static mount but a small allowlist of explicit routes, so every /assets/install/*.webp returned 404 and the new guide rendered without images. The stylesheet and script are also cache-busted by query string, and leaving the version untouched meant browsers kept the previous script, which still looked for the old three step keys and left every step empty.

Add an allowlisted route for the screenshots and bump the asset version.
---
 app/main.py                      | 11 +++++++++++
 app/static/desktop-download.html |  4 ++--
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/app/main.py b/app/main.py
index f8b80954..2934ad89 100644
--- a/app/main.py
+++ b/app/main.py
@@ -1167,6 +1167,17 @@ async def hsk_ai_cover():
     )
 
 
+@app.get("/assets/install/{filename}")
+async def desktop_install_screenshot(filename: str):
+    import re
+    if not re.fullmatch(r"(?:mac|win)-[0-9]{2}-[a-z0-9]+\.webp", filename):
+        return JSONResponse(status_code=404, content={"error": "not_found"})
+    return static_asset_response(
+        f"app/static/assets/install/{filename}",
+        "image/webp",
+    )
+
+
 @app.get("/course_v3_{page}.html")
 async def course_v3_sub_page(page: str):
     if page not in _COURSE_V3_PAGES:
diff --git a/app/static/desktop-download.html b/app/static/desktop-download.html
index bb6559d3..e9b8480b 100644
--- a/app/static/desktop-download.html
+++ b/app/static/desktop-download.html
@@ -15,8 +15,8 @@
       content="HSK AI ilovasini macOS yoki Windows uchun yuklab oling."
     >
     <link rel="icon" href="/assets/hsk-ai-avatar.webp" type="image/webp">
-    <link rel="stylesheet" href="/desktop-download-page.css?v=20260809-1">
-    <script src="/desktop-download-page.js?v=20260809-1" defer></script>
+    <link rel="stylesheet" href="/desktop-download-page.css?v=20260809-2">
+    <script src="/desktop-download-page.js?v=20260809-2" defer></script>
   </head>
   <body>
     <a class="skip-link" href="#download-card" data-i18n="skip">Yuklashga o‘tish</a>
-- 
