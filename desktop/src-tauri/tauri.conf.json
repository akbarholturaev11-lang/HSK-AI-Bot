{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HSK AI",
  "version": "1.3.5",
  "identifier": "com.pomp.hskai",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HSK AI",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https://telegram-chinese-bot-production.up.railway.app; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "runtime/": "runtime/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "HSK learning desktop app",
    "longDescription": "HSK AI brings the HSK course to macOS and Windows with an optional local AI tutor.",
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0RDE1QTMyMjE4Q0JFMwpSV1RqeXhnaW94Vk5BV1RiUFduUmQrcTlDUWNjRTJaYnd6Z1J6VkdURHh1MXlJRElOKzhYU2R6Mwo=",
      "endpoints": [
        "https://telegram-chinese-bot-production.up.railway.app/api/v3/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
