<!-- Default locale: Uzbek (Latin). -->
<!--
    Wording only the `direct` channel (APK, website, Telegram) may show.
    It is a source set rather than a runtime flag on purpose: the Google
    Play build must not CONTAIN an external checkout, not merely hide it.
-->
<resources>
    <string name="limit_unlock_headline">Limitsiz oching 👇🏽</string>
    <string name="limit_unlock_button">Limitsiz o‘qish</string>
    <string name="limit_unlock_hint">Tugma Telegram botni ochadi. Obuna o‘sha yerda rasmiylashtiriladi, keyin bu yerda hammasi ochiladi.</string>
    <string name="limit_unlock_unavailable">Telegram botni ochib bo‘lmadi. Botga o‘zingiz kiring yoki keyinroq urinib ko‘ring.</string>

    <!--
        In-app updating. Only this channel may do it: Google Play
        forbids an app it distributes from updating itself by any
        other route, so the Play build has none of this.
    -->
    <string name="update_card_title">Yangi versiya %1$s</string>
    <string name="update_card_subtitle">%1$s · yangilash uchun bosing</string>
    <string name="update_card_downloading">Yuklanmoqda…</string>
    <string name="update_card_failed">Yuklab bo‘lmadi — qayta urinib ko‘ring</string>
    <string name="update_card_permission">O‘rnatishga ruxsat bering</string>
    <string name="update_card_permission_hint">Android sozlamalari ochiladi</string>

    <!--
        Two releases behind: the banner above the tab bar, and the one
        notification a release is allowed to send.
    -->
    <string name="update_banner_text">Yangi versiya %1$s — yangilash uchun bosing</string>
    <string name="update_banner_downloading">Yuklanmoqda…</string>
    <string name="update_banner_failed">Yuklab bo‘lmadi — qayta urinib ko‘ring</string>
    <string name="update_banner_permission">O‘rnatishga ruxsat bering — yangilash uchun bosing</string>
    <string name="update_channel_name">Ilova yangilanishlari</string>
    <string name="notify_update_title">Yangi versiya chiqdi</string>
    <string name="notify_update_body">HSK AI %1$s tayyor. Yangilash uchun ilovani oching.</string>
</resources>
