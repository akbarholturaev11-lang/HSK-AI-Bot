    android:orientation="horizontal" android:gravity="center" android:padding="12dp"
    android:background="@drawable/widget_preview_background">
    <ImageView android:layout_width="64dp" android:layout_height="76dp"
        android:src="@drawable/widget_panda_invite" android:contentDescription="@null" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_name" android:textColor="#211D17" android:textSize="16sp"
        android:textStyle="bold" android:maxLines="2" />
</LinearLayout>
