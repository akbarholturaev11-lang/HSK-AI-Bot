<?xml version="1.0" encoding="utf-8"?>
<!--
    Default locale: Uzbek (Latin).
    Russian lives in values-ru, Tajik in values-tg.
    NOTE: the backend language code for Tajik is "tj", while the Android
    resource qualifier is "tg" (ISO 639-1). LanguageCodes owns that mapping;
    never rename the folder and never send "tg" to the API.
-->
<resources>
    <!-- Brand name and language endonyms are shown identically in every
         locale, so they are deliberately not translated. Without this, lint's
         MissingTranslation check fails the build. -->
    <string name="app_name" translatable="false">Pomp HSK AI</string>

