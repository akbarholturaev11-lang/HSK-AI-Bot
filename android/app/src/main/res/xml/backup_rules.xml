<?xml version="1.0" encoding="utf-8"?>
<!--
    Backups are disabled at the application level (android:allowBackup="false").
    This file exists so the manifest reference resolves and so the intent is
    explicit: authentication credentials and cached progress must never leave
    the device in a backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
