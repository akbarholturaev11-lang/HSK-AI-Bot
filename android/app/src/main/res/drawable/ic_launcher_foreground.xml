<?xml version="1.0" encoding="utf-8"?>
<!--
    HSK AI knot. Two rounded squares, one turned 45 degrees, woven: each strand
    passes over at four crossings and under at the other four. An under-pass is
    cut by a casing stroke painted in the background gradient, so the gap reads
    as the cinnabar behind the knot — which is why the casing gradient must stay
    identical to ic_launcher_background.xml. The whole knot sits inside the
    adaptive-icon safe circle, so no OEM mask can bite into it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Strand A, flat: casing first, then the gold. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M39.5,35 H68.5 A4.5,4.5 0 0 1 73,39.5 V68.5 A4.5,4.5 0 0 1 68.5,73 H39.5 A4.5,4.5 0 0 1 35,68.5 V39.5 A4.5,4.5 0 0 1 39.5,35 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="9.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FFF0614C"
                android:endColor="#FFC02F32" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M39.5,35 H68.5 A4.5,4.5 0 0 1 73,39.5 V68.5 A4.5,4.5 0 0 1 68.5,73 H39.5 A4.5,4.5 0 0 1 35,68.5 V39.5 A4.5,4.5 0 0 1 39.5,35 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="28"
                android:endX="0"
                android:endY="80"
                android:startColor="#FFF7C948"
                android:endColor="#FFD9920F" />
        </aapt:attr>
    </path>

    <!-- Strand B, turned 45 degrees, laid over strand A. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M57.18,30.31 L77.69,50.82 A4.5,4.5 0 0 1 77.69,57.18 L57.18,77.69 A4.5,4.5 0 0 1 50.82,77.69 L30.31,57.18 A4.5,4.5 0 0 1 30.31,50.82 L50.82,30.31 A4.5,4.5 0 0 1 57.18,30.31 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="9.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FFF0614C"
                android:endColor="#FFC02F32" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M57.18,30.31 L77.69,50.82 A4.5,4.5 0 0 1 77.69,57.18 L57.18,77.69 A4.5,4.5 0 0 1 50.82,77.69 L30.31,57.18 A4.5,4.5 0 0 1 30.31,50.82 L50.82,30.31 A4.5,4.5 0 0 1 57.18,30.31 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="28"
                android:endX="0"
                android:endY="80"
                android:startColor="#FFF7C948"
                android:endColor="#FFD9920F" />
        </aapt:attr>
    </path>

    <!-- Strand A returns over strand B at every other crossing. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M39.5,35 H52.9 M73,39.5 V52.9 M68.5,73 H55.1 M35,68.5 V55.1"
        android:strokeWidth="9.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FFF0614C"
                android:endColor="#FFC02F32" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M39.5,35 H52.9 M73,39.5 V52.9 M68.5,73 H55.1 M35,68.5 V55.1"
        android:strokeWidth="6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="28"
                android:endX="0"
                android:endY="80"
                android:startColor="#FFF7C948"
                android:endColor="#FFD9920F" />
        </aapt:attr>
    </path>
</vector>
