<?xml version="1.0" encoding="utf-8"?>
<!--
    HSK AI notification mark.

    Android renders small notification icons from alpha only and applies the
    system tint itself, so this must stay a single-colour transparent glyph.
    It reuses the same woven-knot geometry as ic_launcher_monochrome.xml, but
    scales it up inside the 24dp notification canvas so the mark remains
    legible in the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.35"
        android:scaleY="1.35">

        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M67.87,35 H68.5 A4.5,4.5 0 0 1 73,39.5 V55.87 M73,67.87 V68.5 A4.5,4.5 0 0 1 68.5,73 H52.13 M40.13,73 H39.5 A4.5,4.5 0 0 1 35,68.5 V52.13 M35,40.13 V39.5 A4.5,4.5 0 0 1 39.5,35 H55.87"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="6" />

        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="45">
            <path
                android:fillColor="@android:color/transparent"
                android:pathData="M67.87,35 H68.5 A4.5,4.5 0 0 1 73,39.5 V55.87 M73,67.87 V68.5 A4.5,4.5 0 0 1 68.5,73 H52.13 M40.13,73 H39.5 A4.5,4.5 0 0 1 35,68.5 V52.13 M35,40.13 V39.5 A4.5,4.5 0 0 1 39.5,35 H55.87"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeWidth="6" />
        </group>
    </group>
</vector>
