<?xml version="1.0" encoding="utf-8"?>
<!--
    Cinnabar ground of the HSK AI knot. It is a drawable rather than a colour
    because the foreground's casing strokes are painted with the very same
    gradient: that is what cuts the under-passes out of the knot.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FFF0614C"
                android:endColor="#FFC02F32" />
        </aapt:attr>
    </path>
</vector>
