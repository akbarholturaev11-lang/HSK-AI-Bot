# Source-backed learner QA ONLY. NEVER deploy this image to production.
# No scripts/start.sh, Alembic, Telegram, DB, payment or AI providers.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN python -m pip install --no-cache-dir fastapi==0.116.1 uvicorn==0.35.0
COPY app/__init__.py app/__init__.py
COPY app/qa_professional45_preview.py app/qa_professional45_preview.py
COPY app/static/ app/static/
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn app.qa_professional45_preview:app --host 0.0.0.0 --port ${PORT:-8080}"]
