# Copy this file to repository-root .env.p3-local-qa (never commit the real file).
# Generate a hex-only random password locally with:
#   openssl rand -hex 24
P3_QA_DB_PASSWORD=REPLACE_WITH_NEW_RANDOM_HEX_STRING

# Token must belong to the previously approved QA bot @Gentss_3bot,
# not the HSK AI production Telegram bot. Never post it in chat/GitHub.
P3_QA_BOT_TOKEN=REPLACE_WITH_SEPARATE_TEST_BOT_TOKEN

# First test in desktop browser over localhost. For real Telegram Mini App
# replace with a temporary HTTPS tunnel origin and restart the API service.
P3_QA_PUBLIC_ORIGIN=http://localhost:18080
