BOT_TOKEN=
OPENAI_API_KEY=

# Gemini asosiy AI provayder. To'ldirilsa Gemini ishlaydi, bo'sh bo'lsa yoki
# xato bersa OpenAI zaxira sifatida ishga tushadi.
GEMINI_API_KEY=
# Admin panelda model tanlanmagan bo'lsa ishlatiladigan standart Gemini modeli.
GEMINI_MODEL=gemini-2.5-flash
# Gemini'ning OpenAI-mos endpointi (odatda o'zgartirilmaydi).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/telegram_chinese_bot
REDIS_URL=redis://localhost:6379/0

ADMIN_IDS=7965751363
FEEDBACK_NOTIFY_CHAT_IDS=-1004311413349
BOT_USERNAME=
MINI_APP_BASE_URL=https://telegram-chinese-bot-production.up.railway.app/course-v3.html

# Pomp HSK AI desktop releases stay fail-closed until real, clean-machine-tested
# HTTPS artifacts are published. Installer files live outside Git (for example R2).
# The final artifact response (after redirects) must send Content-Disposition:
# attachment and Access-Control-Allow-Origin: https://web.telegram.org.
DESKTOP_DOWNLOADS_ENABLED=false
DESKTOP_DOWNLOAD_BASE_URL=
DESKTOP_MAC_DOWNLOAD_URL=
DESKTOP_WINDOWS_DOWNLOAD_URL=
DESKTOP_MAC_VERSION=
DESKTOP_WINDOWS_VERSION=
# Preferred production release source. Configure this stable URL once; the
# legacy per-version values remain fallback only when this is blank.
DESKTOP_RELEASE_MANIFEST_URL=
DESKTOP_RELEASE_MANIFEST_CACHE_TTL_SECONDS=60
DESKTOP_RELEASE_MANIFEST_TIMEOUT_SECONDS=5
DESKTOP_RELEASE_MANIFEST_MAX_BYTES=65536
# Public Tauri updater manifest. URLs must be credential-free HTTPS artifacts:
# macOS `.app.tar.gz`, Windows `.exe`. Detached signatures are required.
DESKTOP_UPDATES_ENABLED=false
DESKTOP_MAC_UPDATER_URL=
DESKTOP_MAC_UPDATER_SIGNATURE=
DESKTOP_MAC_UPDATER_NOTES=
DESKTOP_WINDOWS_UPDATER_URL=
DESKTOP_WINDOWS_UPDATER_SIGNATURE=
DESKTOP_WINDOWS_UPDATER_NOTES=
DESKTOP_DOWNLOAD_RATE_LIMIT_COUNT=3
DESKTOP_DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=900
DESKTOP_DOWNLOAD_REQUEST_TOKEN_TTL_SECONDS=86400
DESKTOP_DOWNLOAD_AUTH_MAX_AGE_SECONDS=86400
DESKTOP_AUTH_SIGNING_SECRET=
DESKTOP_AUTH_LINK_TTL_SECONDS=600
DESKTOP_AUTH_LINK_GLOBAL_RATE_LIMIT_COUNT=120
DESKTOP_AUTH_LINK_GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
DESKTOP_AUTH_ACCESS_TTL_SECONDS=900
DESKTOP_AUTH_REFRESH_TTL_DAYS=30
DESKTOP_AUTH_RECORD_RETENTION_DAYS=30
ADMIN_MINIAPP_AUTH_MAX_AGE_SECONDS=86400

# Optional persistent upload root. On Railway, attach a Volume and set this to the mount path
# or rely on RAILWAY_VOLUME_MOUNT_PATH. Without persistent storage, uploaded course ads
# disappear after deploy/restart.
MEDIA_ROOT=

DEFAULT_LANGUAGE=tj
LOG_LEVEL=INFO
